---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import hero from '../assets/hero.png';
import { company } from '../data/company';
import { imagesIn } from '../data/images';

// Slider kiểu betaviet.vn: fade 1s, tự chuyển sau DELAY, mũi tên.
// Hover/focus tạm dừng tự chuyển; reduced-motion thì không tự chạy.
// Slide 1 là hero chữ; slide sau là banner dựng bằng scripts/banners.mjs (src/assets/slider/), thêm vào items.
// Chỉ 1 slide thì ẩn mũi tên, không tự chuyển.
const DELAY = 7000;
const items: { name: string; href: string; label: string; alt: string }[] = [];
const pick = (name: string) => imagesIn('slider').find((m) => m.src.includes(name))!;
const banners = await Promise.all(
  items.map(async (it) => {
    const d = await getImage({ src: pick(`${it.name}-desktop`), widths: [1280, 1920, 2400], format: 'webp' });
    const m = await getImage({ src: pick(`${it.name}-mobile`), widths: [375, 750], format: 'webp' });
    return { ...it, desktop: d.srcSet.attribute, mobile: m };
  }),
);
const total = banners.length + 1;
const xa = company.address.match(/xã [^,]+/)?.[0] ?? 'Hà Nội';
const lead = `${company.name}, mã số thuế ${company.taxCode}, là công ty xây dựng nhà ở Hà Nội, trụ sở tại ${xa}. Gia Khánh nhận xây nhà, sửa chữa, cải tạo, thiết kế và hoàn thiện nội thất. Kỹ sư khảo sát miễn phí, có dự toán trước khi ký.`;
---

<section
  class="hero-slider relative isolate overflow-hidden bg-white"
  aria-roledescription="carousel"
  aria-label="Giới thiệu dịch vụ Gia Khánh"
  data-delay={DELAY}
  data-slider
  data-reveal
>
  <!-- Từ lg: khung đúng tỷ lệ banner 2,4:1 → banner không bao giờ bị cắt -->
  <div class="grid lg:aspect-[12/5]">
    <div class="slide is-active relative isolate [grid-area:1/1]" role="group" aria-roledescription="slide" aria-label={`1 / ${total}`} data-slide>
      <Image src={hero} alt="" width={1920} loading="eager" class="absolute inset-0 -z-20 h-full w-full object-cover object-right" />
      <!-- Lớp trắng giữ chữ dễ đọc: phủ đều trên mobile, mờ dần sang phải trên desktop -->
      <div
        class="absolute inset-0 -z-10 bg-white/75 md:bg-transparent md:bg-linear-to-r md:from-white/95 md:via-white/60 md:to-transparent"
        aria-hidden="true"
      >
      </div>
      <span class="slide-num pointer-events-none absolute right-6 bottom-0 -z-10 hidden text-[10rem] leading-none font-bold lg:block" aria-hidden="true">01</span>
      <div class="slide-body container-page flex min-h-[34rem] flex-col justify-center pt-16 pb-28 md:py-24 lg:h-full lg:min-h-0 lg:px-20 lg:pt-6 lg:pb-16 xl:px-6">
        {/* Khẩu hiệu (company.slogan) tạm ẩn cho tới khi chọn khẩu hiệu chính thức */}
        <h1 class="max-w-2xl text-4xl font-bold md:text-5xl">Gia Khánh, công ty xây dựng nhà ở Hà Nội</h1>
        <p class="mt-6 max-w-2xl leading-relaxed md:text-lg">{lead}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/lien-he/" class="btn btn-primary">Nhận báo giá miễn phí</a>
          <a href={company.telUrl} class="btn btn-outline bg-white">Gọi ngay {company.phoneDisplay}</a>
          <a href={company.zaloUrl} class="btn btn-outline bg-white" target="_blank" rel="noopener">Chat Zalo</a>
        </div>
      </div>
    </div>
    {
      banners.map((b, i) => (
        <div class="slide relative [grid-area:1/1]" role="group" aria-roledescription="slide" aria-label={`${i + 2} / ${total}`} data-slide>
          <a href={b.href} class="absolute inset-0 bg-primary-dark" title={`Xem ${b.label}`}>
            <picture>
              <source media="(min-width: 1024px)" srcset={b.desktop} sizes="100vw" />
              <img
                src={b.mobile.src}
                srcset={b.mobile.srcSet.attribute}
                sizes="(min-width: 640px) 50vw, 100vw"
                alt={b.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain lg:object-cover"
              />
            </picture>
          </a>
        </div>
      ))
    }
  </div>

  <!-- Điều khiển: mobile 2 mũi tên ở giữa đáy, từ md ra 2 bên -->
  {total > 1 && <div class="slider-ui pointer-events-none absolute inset-0 flex items-end justify-center gap-4 pb-6 *:pointer-events-auto">
    <button type="button" class="slider-btn md:absolute md:top-1/2 md:left-4 md:-translate-y-1/2" aria-label="Slide trước" data-prev>
      <Icon name="arrow" class="size-5 rotate-180" />
    </button>
    <button type="button" class="slider-btn md:absolute md:top-1/2 md:right-4 md:-translate-y-1/2" aria-label="Slide tiếp theo" data-next>
      <Icon name="arrow" class="size-5" />
    </button>
  </div>}
</section>

<style>
  .slide {
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease, visibility 1s;
  }
  .slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  /* Chữ trượt lên nhẹ khi slide hiện */
  .slide-body > * {
    transform: translateY(16px);
    opacity: 0;
    transition: transform 0.7s ease-out 0.3s, opacity 0.7s ease-out 0.3s;
  }
  .is-active .slide-body > * {
    transform: none;
    opacity: 1;
  }
  .slide-num {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-primary-bright);
    opacity: 0.35;
  }
  .slider-btn {
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    background: rgb(255 255 255 / 0.85);
    color: var(--color-primary);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
    transition: background-color 0.2s, color 0.2s;
  }
  .slider-btn:hover {
    background: var(--color-primary);
    color: #fff;
  }
  /* Không JS: chỉ hiện slide đầu, ẩn điều khiển */
  :global(html:not(.js)) .slider-ui {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide-body > * {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length < 2) return;
    const delay = Number(root.dataset.delay);
    const auto = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer = 0;
    let paused = false;
    const restart = () => {
      clearTimeout(timer);
      if (auto && !paused) timer = window.setTimeout(() => show(i + 1), delay);
    };
    const pause = (p: boolean) => {
      paused = p;
      restart();
    };
    const show = (n: number) => {
      slides[i].classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-active');
      restart();
    };
    root.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
    root.addEventListener('mouseenter', () => pause(true));
    root.addEventListener('mouseleave', () => pause(false));
    root.addEventListener('focusin', () => pause(true));
    root.addEventListener('focusout', () => pause(false));
    // Vuốt trên điện thoại
    let x0 = 0;
    root.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1);
    });
    restart();
  });
</script>
