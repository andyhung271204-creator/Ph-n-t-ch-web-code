// Hoàn thiện, điện nước lấy từ bảng bảo hành chung; nội thất chưa có mốc
const warrantyRows = [
  ...warranty
    .filter((w) => w.item.startsWith('Hoàn thiện') || w.item === 'Điện nước')
    .map((w) => ({ item: w.item, value: w.period })),
  { item: 'Đồ gỗ nội thất', value: 'Đang cập nhật' }, // TODO: thời hạn bảo hành nội thất
];
---

<section class="section" data-reveal>
  <div class="container-page">
    <SectionHeading
      title="Hoàn thiện nhà và thi công nội thất khác nhau thế nào?"
      subtitle="Hoàn thiện nhà là những hạng mục gắn liền với ngôi nhà, làm sau phần thô để nhà dùng được, như ốp lát, sơn bả, trần và cửa. Thi công nội thất là đồ gỗ làm theo kích thước căn nhà của bạn, như tủ bếp và tủ quần áo, đặt vào sau khi hoàn thiện xong."
    />
    <div class="overflow-x-auto rounded-lg border border-line bg-white">
      <table class="w-full min-w-[640px] border-collapse">
        <thead>
          <tr>
            <th class={th} scope="col"><span class="sr-only">Tiêu chí</span></th>
            <th class={th} scope="col">Hoàn thiện nhà</th>
            <th class={th} scope="col">Thi công nội thất rời</th>
          </tr>
        </thead>
        <tbody>
          {
            compare.map((c) => (
              <tr>
                <th class={`${td} text-left font-semibold`} scope="row">{c.row}</th>
                <td class={`${td} text-muted`}>{c.finishing}</td>
                <td class={`${td} text-muted`}>{c.furniture}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mx-auto mt-8 max-w-prose text-center leading-relaxed">
      Bạn có thể chọn một trong hai, hoặc nhờ Gia Khánh làm liền mạch từ hoàn thiện đến đồ gỗ để chỉ làm việc với một đầu
      mối.
    </p>
  </div>
</section>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading
      title="Gia Khánh nhận thi công những hạng mục hoàn thiện, nội thất nào?"
      subtitle="Gia Khánh nhận chín nhóm hạng mục: sáu nhóm hoàn thiện (ốp lát, sơn bả, trần thạch cao, cửa và lan can, mái che và giếng trời, lắp đặt thiết bị) và ba nhóm nội thất (tủ bếp, tủ quần áo, đồ gỗ theo thiết kế). Bạn chọn một vài hạng mục hoặc toàn bộ."
    />
    <div class="grid gap-8 md:grid-cols-2 lg:gap-12">
      <div data-reveal>
        <ImageSlot dir="hoan-thien-hang-muc" alt="Phối cảnh biệt thự tân cổ điển 2 tầng lên đèn" />
        <h3 class="mt-6 text-xl font-bold">Hoàn thiện</h3>
        <Bullets
          class="mt-4"
          items={[
            ['Ốp lát:', 'lát nền, ốp tường, ốp nhà vệ sinh, bếp.'],
            ['Sơn bả:', 'xử lý bề mặt, bả, sơn.'],
            ['Trần thạch cao:', 'làm mới, thay trần cũ.'],
            ['Cửa nhôm kính, lan can:', 'đo đạc, lắp đặt.'],
            'Mái che, giếng trời.',
            ['Lắp đặt thiết bị:', 'thiết bị vệ sinh, thiết bị điện.'],
          ]}
        />
      </div>
      <div data-reveal style="--d:90ms">
        <ImageSlot dir="noi-that-hang-muc" alt="Phối cảnh nhà 2 tầng mái bằng, mặt tiền nan gỗ" />
        <h3 class="mt-6 text-xl font-bold">Nội thất</h3>
        <Bullets
          class="mt-4"
          items={['Tủ bếp.', 'Tủ quần áo.', ['Đồ gỗ nội thất theo thiết kế:', 'làm theo bản vẽ, khớp kích thước từng phòng.']]}
        />
      </div>
    </div>
    <div class="mt-12 grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <ImageSlot dir="hoan-thien-cho-ai" alt="Phối cảnh nhà 3 tầng hiện đại, mặt tiền ốp đá vân trắng" />
      <div class="max-w-prose space-y-4 leading-relaxed">
        <p>
          Dịch vụ phù hợp với gia đình vừa xong phần thô nhà ống hoặc nhà phố, chủ nhà cũ muốn làm mới sàn, trần, tường,
          cửa, và chủ cửa hàng, văn phòng nhỏ cần hoàn thiện mặt bằng kinh doanh. Trụ sở Gia Khánh ở Đông Anh, nên hoàn
          thiện nhà Đông Anh và các huyện lân cận thuận tiện cho kỹ sư đến khảo sát.
        </p>
        <p class="text-muted">
          Gia Khánh cũng nhận các hạng mục chống thấm và điện nước. Xem thêm{' '}
          <a href="/dich-vu/sua-chua-cai-tao-nha/" class={link}>Sửa chữa – cải tạo nhà</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section" data-reveal>
  <div class="container-page">
    <SectionHeading
      title="Hoàn thiện nhà phần thô: chọn mức vật tư thế nào?"
      subtitle="Chủng loại vật tư ảnh hưởng trực tiếp đến chi phí, nên cần chốt bằng văn bản trước khi thi công. Gia Khánh ghi chủng loại từng loại vật tư trong dự toán và hợp đồng, để bạn so sánh được các báo giá và nghiệm thu đúng loại đã chọn."
    />
    <div class="mx-auto max-w-prose">
      <h3 class="font-semibold">Bốn yếu tố quyết định chi phí hoàn thiện</h3>
      <ol class="mt-4 space-y-4">
        {
          [
            ['Vật liệu bạn chọn:', 'gạch, sơn, cửa, thiết bị vệ sinh, thiết bị điện.'],
            ['Độ phức tạp của hạng mục:', 'càng nhiều chi tiết, công thi công và thời gian càng tăng.'],
            ['Điều kiện mặt bằng:', 'nhà ống, nhà trong ngõ nhỏ ở Hà Nội, vận chuyển vật liệu khó, số tầng.'],
            ['Yêu cầu riêng:', 'đồ gỗ đặt theo thiết kế, thiết bị nhập riêng.'],
          ].map(([b, t], i) => (
            <li class="flex gap-4 leading-relaxed">
              <span class="shrink-0 font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
              <span><strong>{b}</strong> {t}</span>
            </li>
          ))
        }
      </ol>
      <div class="mt-8 space-y-4 leading-relaxed">
        <p class="rounded-lg bg-primary-light p-4">
          Nên dồn ngân sách cho khu vực dùng nhiều và khó sửa lại, như nhà vệ sinh, bếp và sàn. Phòng ít dùng thì chọn
          mức vừa phải. Bảng so sánh các mức vật liệu nằm trong bài{' '}
          <a href="/cam-nang/chon-vat-lieu-hoan-thien-noi-that/" class={link}>Chọn vật liệu hoàn thiện nội thất</a>.
        </p>
        <p>
          Khi hoàn thiện đi cùng gói xây nhà, có hai cách tính. Ở gói phần thô + nhân công hoàn thiện, chủ nhà mua vật tư
          hoàn thiện còn Gia Khánh lo nhân công. Ở gói trọn gói, Gia Khánh lo cả vật tư theo bảng vật tư trong hợp đồng.
          Xem so sánh hai gói ở trang <a href="/dich-vu/xay-nha-tron-goi/" class={link}>Xây nhà trọn gói</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading title="Hoàn thiện nhà có tính theo m² không, giá bao nhiêu?" />
    <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
      <p>
        Gia Khánh báo giá hoàn thiện theo từng hạng mục sau khi khảo sát, vì mỗi nhà khác nhau về vật liệu, độ phức tạp
        và mặt bằng. Hiện chưa công bố đơn giá hoàn thiện theo m². Kỹ sư đo đạc miễn phí, rồi gửi bảng dự toán trước khi
        bạn ký hợp đồng.
      </p>
      <p>Bảng dự toán ghi từng hạng mục (ốp lát, sơn bả, trần, cửa, tủ bếp...), khối lượng và chủng loại vật tư.</p>
      <p>
        Giá hoàn thiện đi cùng gói xây nhà nằm trong đơn giá của gói đó, xem{' '}
        <a href="/bao-gia/" class={link}>bảng báo giá</a>. Bạn cũng có thể gửi hiện trạng qua form{' '}
        <a href="#bao-gia" class={link}>nhận báo giá miễn phí</a> để hẹn khảo sát.
      </p>
      <p class="rounded-lg bg-white p-4 font-medium">{company.priceNote}</p>
    </div>
  </div>
</section>

<ServiceSteps title="Quy trình hoàn thiện và thi công nội thất tại Gia Khánh" steps={steps} light={false}>
  <div class="mx-auto mt-12 max-w-prose space-y-4 leading-relaxed">
    <p class="rounded-lg bg-primary-light p-4 font-medium">
      Gia Khánh thi công hoàn thiện nhà ở Hà Nội theo quy trình 6 bước chung, từ tiếp nhận đến bảo hành. Kỹ sư khảo sát
      miễn phí tại nhà rồi mới lập dự toán. Hợp đồng được ký sau khi bạn đã xem dự toán và chốt vật liệu, nghiệm thu theo
      từng mốc thi công.
    </p>
    <p class="text-muted">
      Ở bước khảo sát, kỹ sư xem hiện trạng phần thô trước khi lập dự toán. Ảnh các công trình Gia Khánh đã thi công xem
      tại trang <a href="/du-an/" class={link}>Công trình</a>.
    </p>
  </div>
</ServiceSteps>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading
      title="Cam kết và bảo hành khi hoàn thiện, làm nội thất"
      subtitle="Gia Khánh bảo hành bằng văn bản, thời hạn ghi trong hợp đồng và tính riêng cho từng nhóm hạng mục. Thanh toán theo giai đoạn, chỉ sau khi hạng mục được nghiệm thu. Mỗi công trình có một kỹ sư phụ trách để bạn liên hệ trực tiếp khi cần xử lý việc gì."
    />
    <div class="grid gap-8 lg:grid-cols-2">
      <InfoList rows={warrantyRows} />
      <div>
        <h3 class="font-semibold">Cam kết khác trong hợp đồng</h3>
        <Bullets
          class="mt-4"
          items={[
            'Dự toán chi tiết từng hạng mục, không phát sinh khi chưa được chủ nhà đồng ý.',
            'Dùng đúng chủng loại vật tư đã ghi trong hợp đồng.',
            'Ảnh công trình gửi qua Zalo hằng ngày, nên chủ nhà ở xa vẫn theo dõi được.',
            'Vệ sinh công trình sạch sẽ trước khi bàn giao.',
          ]}
        />
        <p class="mt-6 leading-relaxed text-muted">
          Cách đọc và so sánh các mức vật tư có trong bài{' '}
          <a href="/cam-nang/chon-vat-lieu-hoan-thien-noi-that/" class={link}>Chọn vật liệu hoàn thiện nội thất</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<Faq
  title="Câu hỏi thường gặp về hoàn thiện và thi công nội thất"
  subtitle="Gia Khánh khảo sát và báo giá miễn phí cho cả nhà mới xong phần thô lẫn nhà cũ cần làm mới. Tiến độ và bảo hành ghi trong hợp đồng. Kỹ sư đo đạc tại nhà ở Hà Nội rồi gửi dự toán từng hạng mục trước khi bạn ký hợp đồng."
  items={faqs}
/>

<ServiceCta
  title="Nhà đã xong phần thô, hoặc muốn làm mới nhà cũ?"
  subtitle={`Để lại số điện thoại, ${company.name} sẽ gọi lại tư vấn miễn phí và hẹn khảo sát tận nơi. Kỹ sư xem hiện trạng rồi gửi dự toán từng hạng mục. Phục vụ Hà Nội, nội thành và các huyện lân cận.`}
/>
