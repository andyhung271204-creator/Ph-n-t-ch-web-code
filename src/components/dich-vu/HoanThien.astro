    furniture: 'Ghi rõ trong dự toán và hợp đồng.',
  },
];

const steps = [
  {
    name: 'Tiếp nhận & tư vấn',
    text: `Bạn gọi hotline, nhắn Zalo hoặc để lại số điện thoại. Gia Khánh gọi lại tư vấn sơ bộ${daXacNhan ? ' trong 2 giờ làm việc' : ''}.`,
  },
  {
    name: 'Khảo sát hiện trạng (miễn phí)',
    text: 'Kỹ sư đến tận nơi, đo đạc, xem hiện trạng, ghi nhận nhu cầu và ngân sách.',
  },
  {
    name: 'Thiết kế & báo giá chi tiết',
    text: 'Gia Khánh gửi phương án thiết kế (nếu có) và dự toán từng hạng mục. Đây là lúc chốt vật liệu.',
  },
  { name: 'Ký hợp đồng', text: 'Hai bên chốt giá trị, tiến độ theo mốc, thanh toán theo giai đoạn, bảo hành.' },
  {
    name: 'Thi công & giám sát',
    text: 'Kỹ sư phụ trách có mặt tại công trình, gửi ảnh tiến độ hằng ngày qua Zalo, nghiệm thu từng giai đoạn cùng bạn.',
  },
  { name: 'Bàn giao & bảo hành', text: 'Nghiệm thu tổng thể, vệ sinh công trình, bàn giao hồ sơ, kích hoạt bảo hành.' },
];

// Câu có placeholder trong bản nháp (thiết kế ngoài, nhà đang ở, mất bao lâu) đã đổi sang bản trung tính, không còn chỗ trống
const faqs = [
  {
    q: 'Hoàn thiện nhà khác thi công nội thất rời ở đâu?',
    a: 'Hoàn thiện là ốp lát, sơn bả, trần, cửa, thiết bị, gắn liền với ngôi nhà và làm trước. Nội thất rời là tủ bếp, tủ quần áo, đồ gỗ làm theo kích thước nhà, đặt vào sau.',
  },
  {
    q: 'Xong phần thô, nên hoàn thiện cùng nhà thầu cũ hay thuê đơn vị khác?',
    a: 'Cùng một nhà thầu thì chỉ có một đầu mối. Nếu phần thô do đơn vị khác làm, kỹ sư xem hiện trạng khi khảo sát miễn phí rồi báo bạn hạng mục nào cần xử lý trước.',
  },
  {
    q: 'Nên chọn gói phần thô + nhân công hoàn thiện hay trọn gói?',
