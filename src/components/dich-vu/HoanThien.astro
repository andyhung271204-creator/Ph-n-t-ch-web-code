import { company, daXacNhan, warranty } from '../../data/company';

const th = 'bg-primary-light p-4 text-left font-semibold';
const td = 'border-t border-line p-4 align-top';
const link = 'font-semibold text-primary underline hover:text-primary-dark';

// TODO: ai mua vật tư khi nhận hoàn thiện riêng lẻ / thi công nội thất chưa xác nhận, dùng cách nói trung tính
const compare = [
  {
    row: 'Gồm',
    finishing: 'Ốp lát, sơn bả, trần thạch cao, cửa nhôm kính, lan can, mái che, giếng trời, lắp thiết bị.',
    furniture: 'Tủ bếp, tủ quần áo, đồ gỗ theo thiết kế.',
  },
  {
    row: 'Khi nào cần',
    finishing: 'Nhà vừa xong phần thô, hoặc nhà cũ cần làm mới lớp hoàn thiện.',
    furniture: 'Khi đã chốt công năng từng phòng, hoặc muốn đồ đạc khớp từng góc nhà.',
