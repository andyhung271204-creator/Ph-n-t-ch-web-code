    />
    <div class="overflow-x-auto rounded-lg border border-line bg-white">
      <table class="w-full min-w-[640px] border-collapse">
        <thead>
          <tr>
            <th class={th} scope="col">Hạng mục</th>
            <th class={th} scope="col">Trong hồ sơ thiết kế</th>
            <th class={th} scope="col">Nội dung</th>
          </tr>
        </thead>
        <tbody>
          {
            deliverables.map((d) => (
              <tr>
                <th class={`${td} text-left font-semibold`} scope="row">{d.item}</th>
                <td class={`${td} font-semibold text-primary`}>{d.inc}</td>
                <td class={`${td} text-muted`}>
                  {d.item === 'Thi công công trình' ? (
                    <>
                      Tính riêng nếu bạn chọn Gia Khánh thi công, xem{' '}
                      <a href="/dich-vu/xay-nha-tron-goi/" class={link}>Xây nhà trọn gói</a>.
                    </>
