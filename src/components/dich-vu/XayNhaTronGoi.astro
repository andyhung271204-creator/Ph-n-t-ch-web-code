---
// Nội dung: noi-dung/dich-vu-xay-nha-tron-goi.md (brief SEO: noi-dung/seo/brief/xay-nha-tron-goi.md)
import SectionHeading from '../SectionHeading.astro';
import Bullets from '../Bullets.astro';
import InfoList from '../InfoList.astro';
import ImageSlot from '../ImageSlot.astro';
import ServiceSteps from '../ServiceSteps.astro';
import Faq from '../Faq.astro';
import { company, daXacNhan, prices, packages, warranty } from '../../data/company';

const th = 'bg-primary-light p-4 text-left font-semibold';
const td = 'border-t border-line p-4 align-top';
const link = 'font-semibold text-primary underline hover:text-primary-dark';

const [rough, full, labor] = packages;
const pho = prices[1]; // nhà phố, nhà ống 2 – 5 tầng (đã xác nhận)

const compare = [
  { row: 'Gồm', rough: rough.includes, full: full.includes },
  { row: 'Chủ nhà tự lo', rough: rough.owner, full: full.owner },
  {
    row: 'Hợp với ai',
    rough: 'Gia đình muốn tự chọn mẫu mã vật tư hoàn thiện và có thời gian đi mua.',
    full: 'Gia đình muốn một hợp đồng lo hết, nhận nhà là vào ở.',
  },
  { row: 'Ai mua vật tư hoàn thiện', rough: 'Chủ nhà.', full: 'Gia Khánh, theo bảng vật tư trong hợp đồng.' },
];

const steps = [
  {
    name: 'Tiếp nhận & tư vấn',
    text: `Bạn liên hệ qua hotline, Zalo, fanpage hoặc form. Gia Khánh gọi lại tư vấn sơ bộ${daXacNhan ? ' trong 2 giờ làm việc' : ''}.`,
  },
  { name: 'Khảo sát hiện trạng (miễn phí)', text: 'Kỹ sư đo đạc tại nhà, ghi nhận nhu cầu và ngân sách.' },
  {
    name: 'Thiết kế & báo giá chi tiết',
    text: 'Gia Khánh lập phương án thiết kế (nếu có) và dự toán từng hạng mục, vật tư ghi rõ chủng loại.',
  },
  { name: 'Ký hợp đồng', text: 'Hai bên chốt giá trị, tiến độ theo mốc, thanh toán theo giai đoạn và bảo hành.' },
  {
    name: 'Thi công & giám sát',
    text: 'Kỹ sư phụ trách giám sát tại công trình, gửi ảnh tiến độ hằng ngày qua Zalo, nghiệm thu từng giai đoạn cùng bạn.',
  },
  { name: 'Bàn giao & bảo hành', text: 'Nghiệm thu tổng thể, bàn giao hồ sơ, kích hoạt bảo hành và chăm sóc sau bàn giao.' },
];

const faqs = [
  {
    q: 'Khảo sát và báo giá có mất phí không?',
    a: 'Không. Kỹ sư Gia Khánh đến tận nơi khảo sát và gửi báo giá chi tiết miễn phí.',
  },
  {
    q: 'Xây nhà trọn gói mất bao lâu?',
    a: `${daXacNhan ? 'Nhà phố 3 – 4 tầng thường mất khoảng 4 – 6 tháng, tùy diện tích và thời tiết. ' : 'Thời gian tùy diện tích, số tầng và thời tiết. '}Tiến độ cụ thể theo từng mốc được ghi trong hợp đồng.`,
  },
  {
    q: 'Trọn gói có đắt hơn tự thuê thợ không?',
    a: 'Tự mua vật tư và thuê từng tổ thợ có thể rẻ hơn nếu bạn mua khéo và có thời gian theo sát. Trọn gói đổi phần chênh đó lấy một đầu mối, giá chốt trước và bảo hành bằng văn bản.',
  },
  {
    q: 'Có cần thuê người giám sát riêng không?',
    a: 'Mỗi công trình của Gia Khánh có một kỹ sư phụ trách giám sát và nghiệm thu từng giai đoạn cùng bạn. Việc thuê thêm giám sát độc lập do bạn quyết định.',
  },
  {
    q: 'Thanh toán như thế nào?',
    a: 'Gia Khánh nhận thanh toán theo từng giai đoạn thi công. Mỗi đợt đến sau khi hạng mục được nghiệm thu cùng bạn, và các đợt được ghi trong hợp đồng.',
  },
  { q: 'Đơn giá đã gồm VAT, phá dỡ và ép cọc chưa?', a: `Chưa. ${company.priceNote}` },
  {
    q: 'Tôi ở xa, làm sao theo dõi công trình?',
    a: 'Kỹ sư Gia Khánh gửi ảnh tiến độ hằng ngày qua Zalo, và nghiệm thu từng giai đoạn cùng bạn tại công trình.',
  },
  // TODO: hồ sơ chưa có điều kiện đường vào cho nhà xây mới
  {
    q: 'Nhà trong ngõ nhỏ có xây được không?',
    a: 'Điều này phụ thuộc điều kiện đường vào khu đất. Bạn gửi địa chỉ để kỹ sư Gia Khánh khảo sát và tư vấn.',
  },
];
---

<section class="section" data-reveal>
  <div class="container-page grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div class="max-w-prose">
      <h2 class="text-2xl font-bold md:text-3xl">Xây nhà trọn gói là gì?</h2>
      <p class="mt-4 leading-relaxed">
        Trong xây nhà trọn gói, nhà thầu lo vật tư, nhân công và giám sát từ móng đến hoàn thiện, còn gia đình làm việc
        với một đầu mối. Giá trị công trình nằm trong một hợp đồng, kèm bảng vật tư theo chủng loại.
      </p>
      <p class="mt-4 leading-relaxed text-muted">
        Nhà thầu mua vật tư, điều thợ xây, thợ điện nước, thợ sơn theo từng giai đoạn và nghiệm thu cùng bạn. Khi cần hỏi
        hay xử lý việc gì ở công trình, bạn gọi kỹ sư phụ trách.
      </p>

      <h2 class="mt-12 text-2xl font-bold md:text-3xl">Ai nên chọn xây nhà trọn gói?</h2>
      <p class="mt-4 leading-relaxed">
        Xây nhà trọn gói hợp với gia đình có đất, muốn xây nhà ở mới nhưng thiếu thời gian tự mua vật tư và theo dõi từng
        tổ thợ. Hình thức này cũng hợp với chủ nhà ở xa công trình cần một người chịu trách nhiệm tại hiện trường, và với
        người muốn biết tổng chi phí từ đầu.
      </p>
      <p class="mt-4 leading-relaxed text-muted">
        Nếu bạn đã có thợ quen và thích tự chọn từng món vật tư, gói phần thô + nhân công hoàn thiện hoặc gói nhân công
        (xem phần so sánh bên dưới) gần với cách làm đó hơn. Nếu nhà đã có và cần nâng tầng, mở rộng hay sửa, xem{' '}
        <a href="/dich-vu/sua-chua-cai-tao-nha/" class={link}>Sửa chữa – cải tạo nhà</a>.
      </p>
    </div>
    <ImageSlot dir="xay-nha-cho-ai" alt="Phối cảnh nhà phố 2 tầng mái bằng, mặt tiền ốp gỗ" />
  </div>
</section>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading
      title="Trọn gói gồm những hạng mục nào?"
      subtitle="Xây nhà trọn gói tại Gia Khánh đi từ phần móng đến hoàn thiện, chia thành sáu nhóm hạng mục. Phạm vi cụ thể của từng gói được ghi trong hợp đồng và bảng vật tư."
    />
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <ImageSlot dir="xay-nha-hang-muc" alt="Phối cảnh nhà phố 3 tầng hiện đại lên đèn buổi tối" />
      <div>
        <Bullets
          items={[
            ['Móng và kết cấu:', 'móng, cột, dầm, sàn bê tông cốt thép.'],
            ['Xây và tô trát:', 'tường bao, tường ngăn, tô trát hoàn chỉnh.'],
            ['Điện nước âm:', 'đi đường ống, dây dẫn âm tường, âm sàn.'],
            ['Chống thấm:', 'sân thượng, mái, nhà vệ sinh và những vị trí dễ thấm.'],
            ['Mái:', 'mái bê tông, mái tôn hoặc mái ngói theo thiết kế.'],
            ['Hoàn thiện:', 'ốp lát, sơn bả, trần thạch cao, lắp thiết bị, cửa.'],
          ]}
        />
        <p class="mt-6 leading-relaxed">
          {daXacNhan && 'Gia Khánh hỗ trợ xin giấy phép xây dựng. '}Chưa có bản vẽ thì bắt đầu từ{' '}
          <a href="/dich-vu/thiet-ke-kien-truc-noi-that/" class={link}>Thiết kế kiến trúc & nội thất</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section" data-reveal>
  <div class="container-page">
    <SectionHeading title="Nên chọn trọn gói hay phần thô + nhân công hoàn thiện?" />
    <p class="mx-auto max-w-prose leading-relaxed">
      Chọn trọn gói nếu bạn muốn Gia Khánh lo cả vật tư hoàn thiện và nhận nhà để vào ở. Chọn phần thô + nhân công hoàn
      thiện nếu bạn có thời gian đi chọn gạch, sơn, cửa, thiết bị và muốn tự quyết mẫu mã, giá từng món. Hai gói khác
      nhau ở người mua vật tư hoàn thiện.
    </p>
    <div class="mt-10 overflow-x-auto rounded-lg border border-line bg-white">
      <table class="w-full min-w-[640px] border-collapse">
        <thead>
          <tr>
            <th class={th} scope="col"><span class="sr-only">Tiêu chí</span></th>
            <th class={th} scope="col">{rough.name}</th>
            <th class={th} scope="col">{full.name}</th>
          </tr>
        </thead>
        <tbody>
          {
            compare.map((c) => (
              <tr>
                <th class={`${td} text-left font-semibold`} scope="row">{c.row}</th>
                <td class={`${td} text-muted`}>{c.rough}</td>
                <td class={`${td} text-muted`}>{c.full}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="mx-auto mt-10 max-w-prose space-y-4 leading-relaxed">
      <p>
        Với phần thô + nhân công hoàn thiện, bạn nắm quyền chọn từng món vật tư hoàn thiện và cũng nhận luôn việc mua,
        vận chuyển, đối chiếu số lượng. Vật tư về chậm thì thợ ốp lát hoặc thợ sơn phải chờ, nên lịch mua cần khớp với
        tiến độ. Với trọn gói, mẫu mã vật tư đã chốt trong bảng vật tư từ khi ký hợp đồng; muốn đổi sang loại khác, Gia
        Khánh báo giá chênh lệch để bạn đồng ý trước khi làm.
      </p>
      <p>
        Ngoài hai gói trên còn gói <strong>{labor.name.toLowerCase()}</strong>: Gia Khánh lo nhân công thi công toàn bộ
        công trình, {labor.perM2} đ/m²; chủ nhà lo toàn bộ vật tư. Gói này hợp với chủ nhà đã quen mua vật tư và tự điều
        phối được tiến độ giao hàng.
      </p>
      <p class="rounded-lg bg-primary-light p-4 font-medium">{company.priceNote}</p>
      <p>
        Muốn tính chi phí theo từng cách làm, đọc bài{' '}
        <a href="/cam-nang/chi-phi-xay-nha-pho-tron-goi/" class={link}>Chi phí xây nhà phố trọn gói</a>.
      </p>
    </div>
  </div>
</section>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading title="Xây nhà trọn gói tại Hà Nội giá bao nhiêu?" />
    <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
      <p>
        Với {pho.type.toLowerCase()}, đơn giá phần thô + nhân công hoàn thiện là {pho.rough} và trọn gói là {pho.full} sàn
        quy đổi. Các loại nhà khác, như nhà cấp 4, nhà tân cổ điển và biệt thự, được báo giá sau khi kỹ sư khảo sát.
      </p>
      <p class="rounded-lg bg-white p-4 font-medium">{company.priceNote}</p>
      <p>
        Giá tính theo diện tích sàn quy đổi, không theo diện tích đất. Xem{' '}
        <a href="/bao-gia/" class={link}>bảng báo giá xây nhà</a> đầy đủ, và ví dụ quy đổi móng, tầng, tum, sân thượng
        trong bài <a href="/cam-nang/cach-tinh-dien-tich-xay-dung/" class={link}>Cách tính diện tích xây dựng</a>. Chi
        phí phá dỡ nhà cũ và ép cọc tính riêng, phụ thuộc hiện trạng và địa chất khu đất.
      </p>
    </div>
  </div>
</section>

<ServiceSteps title="Quy trình xây nhà trọn gói tại Gia Khánh" steps={steps} light={false}>
  <p class="mx-auto mt-12 max-w-prose rounded-lg bg-primary-light p-4 font-medium">
    Kỹ sư khảo sát miễn phí tại khu đất hoặc ngôi nhà của bạn ở Hà Nội, đo đạc, ghi nhận nhu cầu và ngân sách, rồi mới
    lập dự toán. Hợp đồng được ký sau khi bạn đã xem dự toán.
  </p>
</ServiceSteps>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading title="Làm sao hạn chế phát sinh chi phí?" />
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="max-w-prose">
        <p class="leading-relaxed">
          Muốn hạn chế phát sinh, hãy chốt giá trị công trình trước khi thi công. Gia Khánh lập dự toán từng hạng mục, ghi
          vật tư theo chủng loại và chỉ làm thêm khi bạn xác nhận bằng văn bản hoặc tin nhắn. Bạn thanh toán theo từng
          giai đoạn, sau khi hạng mục được nghiệm thu.
        </p>
        <Bullets
          class="mt-6"
          items={[
            'Mỗi công trình có một kỹ sư phụ trách, có mặt tại công trình và là đầu mối để bạn hỏi.',
            'Ảnh tiến độ gửi qua Zalo hằng ngày, nên chủ nhà ở xa vẫn thấy công trình đang làm đến đâu.',
            'Mọi thay đổi so với hợp đồng được báo giá trước, bạn quyết định làm hay không.',
          ]}
        />
        <p class="mt-6 leading-relaxed text-muted">
          Hợp đồng xây nhà trọn gói của Gia Khánh ghi phạm vi công việc, bảng vật tư theo chủng loại, tiến độ theo mốc,
          các đợt thanh toán và thời gian bảo hành. Đội ngũ thi công hơn 10 người, gồm kỹ sư xây dựng, kiến trúc sư và
          quản lý thi công. Đội ngũ có trên 10 năm kinh nghiệm làm nhà ở dân dụng. Ảnh các công trình Gia Khánh đã thi
          công xem tại trang <a href="/du-an/" class={link}>Công trình</a>.
        </p>
      </div>
      <ImageSlot dir="xay-nha-giam-sat" alt="Phối cảnh nhà 2 tầng mái Thái, cửa chính gỗ" />
    </div>
  </div>
</section>

<section class="section" data-reveal>
  <div class="container-page">
    <SectionHeading
      title="Bảo hành công trình bao lâu?"
      subtitle="Gia Khánh bảo hành bằng văn bản. Thời hạn ghi trong hợp đồng và tính riêng cho bốn nhóm hạng mục: kết cấu, chống thấm, hoàn thiện, điện nước."
    />
    <div class="grid gap-8 lg:grid-cols-2">
      <InfoList rows={warranty.slice(0, 4).map((w) => ({ item: w.item, value: w.period }))} />
      <div>
        <p class="leading-relaxed text-muted">
          Khi có sự cố trong thời hạn bảo hành, bạn liên hệ kỹ sư phụ trách hoặc hotline để Gia Khánh sắp xếp người đến xử
          lý.
        </p>
        <h3 class="mt-6 font-semibold">Cam kết khác trong hợp đồng</h3>
        <Bullets
          class="mt-4"
          items={[
            'Dùng đúng vật tư, chủng loại đã ghi trong hợp đồng.',
            'Chậm tiến độ do lỗi của Gia Khánh sẽ bồi thường theo điều khoản hợp đồng.',
            'Vệ sinh công trình sạch sẽ trước khi bàn giao.',
          ]}
        />
      </div>
    </div>
  </div>
</section>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading title="Gia Khánh nhận xây nhà ở khu vực nào?" />
    <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
      <p>
        Gia Khánh nhận xây nhà tại nội thành Hà Nội và các huyện lân cận: {company.areaList.slice(1).join(', ')}. Trụ sở
        ở {company.address.replace(', TP Hà Nội', '')}, nên kỹ sư đến khảo sát khu đất ở Đông Anh thuận tiện.
      </p>
      <p class="text-muted">
        Đội ngũ quen với nhà ống, nhà trong ngõ và quy định cấp phép tại địa phương. Gửi địa chỉ khu đất qua form hoặc
        Zalo, Gia Khánh sẽ xác nhận lịch khảo sát.
      </p>
    </div>
  </div>
</section>

<Faq title="Câu hỏi thường gặp về xây nhà trọn gói" items={faqs} />
