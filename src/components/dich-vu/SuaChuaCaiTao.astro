---
// Nội dung: noi-dung/dich-vu-sua-chua-cai-tao-nha.md (brief SEO: noi-dung/seo/brief/sua-chua-cai-tao-nha.md)
import SectionHeading from '../SectionHeading.astro';
import Bullets from '../Bullets.astro';
import InfoList from '../InfoList.astro';
import ServiceSteps from '../ServiceSteps.astro';
import Faq from '../Faq.astro';
import { company, daXacNhan, warranty } from '../../data/company';

const th = 'bg-primary-light p-4 text-left font-semibold';
const td = 'border-t border-line p-4 align-top';
const link = 'font-semibold text-primary underline hover:text-primary-dark';

const groups = [
  {
    name: 'Cải tạo, sửa chữa nhà',
    text: 'Cải tạo nhà cũ, nâng tầng, mở rộng, đổi công năng. Cả việc nhỏ như lát lại nền, thay trần, sơn lại, sửa mái.',
    points: ['Kỹ sư tư vấn phạm vi sửa ngay từ buổi khảo sát.'],
  },
  {
    name: 'Chống thấm và xử lý nứt',
    text: 'Chống thấm nhà ở sân thượng, mái, nhà vệ sinh, tường. Xử lý nứt tường nhà và thấm dột cho nhà cũ.',
    points: [
      'Kỹ sư xác định điểm thấm và nguyên nhân rồi mới đề xuất phương án (xem bảng ở phần sau).',
      'Thời hạn bảo hành chống thấm ghi trong hợp đồng (xem phần bảo hành bên dưới).',
    ],
  },
  {
    name: 'Điện nước và bảo trì nhà',
    text: 'Lắp đặt, sửa chữa điện nước nhà ở: hệ thống điện, cấp thoát nước. Bảo trì nhà ở định kỳ cho nhà của gia đình, văn phòng, cửa hàng nhỏ.',
    points: ['Nhận cả việc nhỏ.', ...(daXacNhan ? ['Có mặt nhanh trong nội thành: trong 24 giờ.'] : [])],
  },
];

const symptoms = [
  {
    s: 'Trần tầng dưới ố vàng, loang vệt',
    c: 'Nước thấm từ sàn nhà vệ sinh, sân thượng, mái hoặc đường ống âm sàn ở tầng trên.',
    f: 'Xác định điểm thấm từ phía trên, chống thấm hoặc sửa ống tại nguồn, sau đó mới xử lý và sơn lại trần.',
  },
  {
    s: 'Tường nứt nhỏ trong lớp trát',
    c: 'Lớp trát co ngót hoặc bong theo thời gian.',
    f: 'Xử lý phần trát hỏng, trát lại, sơn khi tường đã khô.',
  },
  {
    s: 'Nứt chéo ở góc cửa, nứt ngang chạy dài',
    c: 'Tải trọng, lún lệch hoặc vấn đề ở kết cấu chịu lực.',
    f: 'Kỹ sư xem trực tiếp, theo dõi vết nứt, đề xuất hướng xử lý phù hợp sau khi kiểm tra.',
  },
  {
    s: 'Ống nước rỉ, chân tường ẩm',
    c: 'Đường ống hoặc mối nối cũ bị rò.',
    f: 'Sửa hoặc thay đoạn ống, chống thấm lại vị trí đó.',
  },
];

// Quy trình 6 bước: việc làm + "Bạn nhận được" gộp vào một đoạn
const steps = [
  {
    name: 'Tiếp nhận & tư vấn',
    text: `Bạn liên hệ qua hotline, Zalo, fanpage hoặc form. Gia Khánh gọi lại tư vấn sơ bộ${daXacNhan ? ' trong 2 giờ làm việc' : ''}. Bạn nhận được: tư vấn sơ bộ.`,
  },
  {
    name: 'Khảo sát hiện trạng (miễn phí)',
    text: 'Kỹ sư đến tận nơi đo đạc, tìm nguyên nhân, ghi nhận nhu cầu và ngân sách. Bạn nhận được: hiểu rõ hiện trạng và việc cần làm.',
  },
  {
    name: 'Thiết kế & báo giá chi tiết',
    text: 'Gia Khánh đề xuất phương án sửa chữa, cải tạo (có thiết kế nếu cần) và lập dự toán từng hạng mục. Bạn nhận được: bảng dự toán, vật tư ghi rõ chủng loại.',
  },
  {
    name: 'Ký hợp đồng',
    text: 'Hai bên chốt giá trị, tiến độ theo mốc, thanh toán theo giai đoạn, bảo hành. Bạn nhận được: hợp đồng bằng văn bản.',
  },
  {
    name: 'Thi công & giám sát',
    text: 'Kỹ sư phụ trách giám sát tại công trình, nghiệm thu từng giai đoạn cùng bạn. Bạn nhận được: ảnh tiến độ hằng ngày qua Zalo.',
  },
  {
    name: 'Bàn giao & bảo hành',
    text: 'Nghiệm thu tổng thể, bàn giao hồ sơ, kích hoạt bảo hành. Bạn nhận được: hồ sơ bàn giao, chăm sóc sau bàn giao.',
  },
];

// Thứ tự theo bản nháp: chống thấm, điện nước, hoàn thiện, sửa chữa nhỏ
const warrantyRows = ['Chống thấm', 'Điện nước', 'Hoàn thiện', 'Sửa chữa nhỏ']
  .map((k) => warranty.find((w) => w.item.startsWith(k)))
  .filter((w) => w !== undefined)
  .map((w) => ({ item: w.item, value: w.period }));

const faqs = [
  {
    q: 'Vì sao nhà tôi thấm dù đã sơn lại?',
    a: 'Vì sơn chỉ che bề mặt, nước vẫn đi vào từ mái, sân thượng hoặc đường ống bên trong. Muốn hết thấm cần tìm đúng điểm thấm và xử lý tại nguồn. Kỹ sư kiểm tra việc này khi khảo sát.',
  },
  {
    q: 'Thấm trần có phải đục cả sàn không?',
    a: 'Không nhất thiết. Nếu nước vào từ lớp mặt sàn hoặc sân thượng, thường xử lý ngay ở lớp mặt; nếu ống âm sàn rò thì cần mở sàn tại vị trí đó. Kỹ sư xác định điểm thấm trước rồi mới đề xuất phạm vi.',
  },
  {
    q: 'Vết nứt tường có nguy hiểm không?',
    a: 'Tùy vết nứt, nhiều vết chỉ nằm ở lớp trát. Vết lớn hoặc dài ra cần kỹ sư xem trực tiếp.',
  },
  {
    q: 'Sửa nhà có phải chuyển ra ngoài ở không?',
    a: 'Tùy phạm vi. Việc nhỏ hoặc sửa từng khu vực thường vẫn ở được. Với cải tạo lớn, kỹ sư tư vấn từ buổi khảo sát để hạn chế ảnh hưởng đến sinh hoạt.',
  },
  // TODO: hồ sơ chưa có thời gian thi công tham khảo cho sửa chữa nhỏ
  {
    q: 'Sửa nhà mất bao lâu?',
    a: 'Tùy hiện trạng và phạm vi việc. Thời gian cụ thể được ghi theo mốc trong hợp đồng sau khi khảo sát.',
  },
  {
    q: 'Chi phí sửa nhà tính thế nào?',
    a: 'Chi phí tính theo từng hạng mục sau khi khảo sát. Giá phụ thuộc mức xuống cấp, quy mô, điều kiện thi công và vật tư bạn chọn, và báo giá chính xác có sau khảo sát. Cách Gia Khánh lập báo giá có trong trang Báo giá.',
  },
  // TODO: hồ sơ chưa có điều kiện thi công nhà trong ngõ nhỏ
  {
    q: 'Nhà trong ngõ nhỏ có sửa được không?',
    a: 'Nhà trong ngõ nhỏ có thể sửa được hay không tùy đường vào ngõ và mặt bằng thi công. Bạn gửi địa chỉ để kỹ sư Gia Khánh khảo sát và tư vấn.',
  },
  {
    q: 'Nên sửa hay xây lại nhà?',
    a: 'Tùy hiện trạng kết cấu và nhu cầu sử dụng, kỹ sư cần xem nhà trước khi kết luận. Nếu nhà xuống cấp nặng, xây lại có thể phù hợp hơn. Bạn có thể xem thêm trang Xây nhà trọn gói và bài Kiểm tra gì trước khi cải tạo nhà cũ.',
  },
];
---

<section class="section" data-reveal>
  <div class="container-page">
    <SectionHeading title="Khi nào nhà cần sửa chữa, cải tạo?" />
    <div class="mx-auto max-w-prose">
      <p class="leading-relaxed">
        Nhà cần được kỹ sư xem khi có vệt ố ở trần, vết nứt mới hoặc đang dài thêm, điện nước chập chờn hay rỉ, hoặc khi
        căn nhà không còn đủ chỗ cho gia đình. Thấm và nứt để lâu thường khó xử lý hơn, nên xem sớm sẽ gọn việc hơn.
      </p>
      <Bullets
        class="mt-6"
        items={[
          [
            'Thấm dột:',
            'vệt ố ở trần, tường ẩm, sân thượng hoặc mái đọng nước, nhà vệ sinh thấm xuống phòng bên dưới.',
          ],
          ['Nứt tường, nứt trần, nứt nền:', 'vết nứt mới xuất hiện hoặc đang dài thêm.'],
          ['Điện nước cũ:', 'nhảy áp-tô-mát, đèn chập chờn, ống nước rỉ, thoát nước chậm.'],
          ['Nhà không còn hợp với gia đình:', 'cần thêm phòng, nâng tầng, mở rộng, đổi bếp, đổi công năng.'],
          ['Xuống cấp theo thời gian:', 'sơn bong, gạch ốp lát hỏng, trần xuống cấp, mái cũ.'],
        ]}
      />
      <p class="mt-6 rounded-lg bg-primary-light p-4 leading-relaxed">
        Nếu chưa chắc nhà có cần sửa, để lại số điện thoại để kỹ sư xem hiện trạng và cho bạn biết việc nào cần làm ngay,
        việc nào để sau. Muốn tự soát nhà trước khi gọi, đọc bài{' '}
        <a href="/cam-nang/kiem-tra-truoc-khi-cai-tao-nha-cu/" class={link}>Kiểm tra gì trước khi cải tạo nhà cũ</a>.
      </p>
    </div>
  </div>
</section>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading
      title="Sửa chữa cải tạo nhà Hà Nội: Gia Khánh nhận những hạng mục nào?"
      subtitle="Công ty TNHH Xây dựng và Đầu tư Gia Khánh nhận ba mảng việc cho nhà ở: cải tạo và sửa chữa nhà, chống thấm và xử lý nứt, điện nước và bảo trì. Bạn có thể giao riêng từng mảng hoặc gộp nhiều mảng trong cùng một công trình, do một kỹ sư phụ trách."
    />
    <ul class="grid gap-6 md:gap-8 lg:grid-cols-3">
      {
        groups.map((g, i) => (
          <li class="card p-6" data-reveal style={`--d:${i * 90}ms`}>
            <h3 class="text-lg font-semibold text-primary">{g.name}</h3>
            <p class="mt-2 leading-relaxed text-muted">{g.text}</p>
            <Bullets class="mt-4 text-sm" items={g.points} />
            {i === 0 && (
              <p class="mt-4 text-sm leading-relaxed">
                Sửa xong muốn làm tiếp nội thất, xem{' '}
                <a href="/dich-vu/hoan-thien-thi-cong-noi-that/" class={link}>Hoàn thiện & thi công nội thất</a>.
              </p>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mx-auto mt-10 max-w-prose text-center leading-relaxed">
      Ảnh các công trình Gia Khánh đã thi công xem tại trang <a href="/du-an/" class={link}>Công trình</a>.
    </p>
  </div>
</section>

<section class="section" data-reveal>
  <div class="container-page">
    <SectionHeading title="Nhà thấm, nứt tường: nguyên nhân thường gặp và cách xử lý" />
    <p class="mx-auto max-w-prose leading-relaxed">
      Muốn hết thấm hay hết nứt, cần tìm đúng nguyên nhân và xử lý tại nguồn, sau đó mới sơn lại. Sơn phủ lên chỗ đang
      thấm sẽ sớm bong lại. Bảng dưới nối triệu chứng thường gặp với nguyên nhân và hướng xử lý; nguyên nhân thật của
      nhà bạn do kỹ sư xác định khi khảo sát.
    </p>
    <div class="mt-10 overflow-x-auto rounded-lg border border-line bg-white">
      <table class="w-full min-w-[640px] border-collapse">
        <thead>
          <tr>
            <th class={th} scope="col">Triệu chứng</th>
            <th class={th} scope="col">Nguyên nhân thường gặp</th>
            <th class={th} scope="col">Hướng xử lý</th>
          </tr>
        </thead>
        <tbody>
          {
            symptoms.map((r) => (
              <tr>
                <th class={`${td} text-left font-semibold`} scope="row">{r.s}</th>
                <td class={`${td} text-muted`}>{r.c}</td>
                <td class={`${td} text-muted`}>{r.f}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mx-auto mt-10 max-w-prose leading-relaxed">
      Vết nứt lớn, dài ra theo thời gian hoặc chạy qua dầm, cột cần kỹ sư xem trực tiếp. Bạn chụp ảnh gửi qua Zalo để
      được tư vấn sơ bộ. Cách kiểm tra nhà cũ đầy đủ hơn có trong bài{' '}
      <a href="/cam-nang/kiem-tra-truoc-khi-cai-tao-nha-cu/" class={link}>Kiểm tra gì trước khi cải tạo nhà cũ</a>.
    </p>
  </div>
</section>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading title="Chi phí sửa nhà tính theo gì?" />
    <div class="mx-auto max-w-prose">
      <p class="leading-relaxed">
        Chi phí sửa nhà tính theo từng hạng mục sau khi kỹ sư khảo sát, vì mỗi căn nhà một hiện trạng. Giá phụ thuộc mức
        xuống cấp, quy mô việc, điều kiện thi công và vật tư bạn chọn. Gia Khánh không báo một con số chung khi chưa xem
        nhà.
      </p>
      <Bullets
        class="mt-6"
        items={[
          ['Hiện trạng nhà:', 'xuống cấp nặng thì phải xử lý nhiều hạng mục hơn.'],
          ['Quy mô:', 'sửa một khu vực hay cải tạo cả căn.'],
          ['Điều kiện thi công:', 'nhà trong ngõ nhỏ, mặt bằng chật, vừa sửa vừa ở.'],
          ['Vật tư bạn chọn:', 'phổ thông hay cao cấp hơn ở từng khu vực.'],
          ['Thay đổi khi thi công:', 'phần bạn đổi yêu cầu được báo giá riêng.'],
        ]}
      />
      <p class="mt-6 rounded-lg bg-white p-4 font-medium">{company.priceNote}</p>
      <p class="mt-6 leading-relaxed">
        Mọi phát sinh được báo giá trước và chỉ làm khi bạn đồng ý. Cách Gia Khánh lập báo giá xem tại trang{' '}
        <a href="/bao-gia/" class={link}>Báo giá</a>.
      </p>
    </div>
  </div>
</section>

<section class="section" data-reveal>
  <div class="container-page">
    <SectionHeading title="Sửa nhà, nâng tầng có cần xin giấy phép không?" />
    <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
      <p>
        Sửa nhà hay nâng tầng có cần giấy phép hay không tùy quy mô công việc và hiện trạng ngôi nhà, nên cần đối chiếu
        quy định hiện hành trước khi làm. Kỹ sư sẽ trao đổi thêm khi khảo sát.
      </p>
      <p class="text-muted">
        {daXacNhan && 'Gia Khánh hỗ trợ xin giấy phép xây dựng. '}Các điểm nên kiểm tra trước khi cải tạo nhà cũ nằm
        trong bài{' '}
        <a href="/cam-nang/kiem-tra-truoc-khi-cai-tao-nha-cu/" class={link}>Kiểm tra gì trước khi cải tạo nhà cũ</a>.
      </p>
    </div>
  </div>
</section>

<ServiceSteps title="Quy trình sửa chữa tại Gia Khánh" steps={steps}>
  <p class="mx-auto mt-12 max-w-prose rounded-lg bg-white p-4 font-medium">
    Quy trình sửa chữa tại Gia Khánh có 6 bước, từ tiếp nhận đến bảo hành. Kỹ sư khảo sát miễn phí tại nhà bạn ở Hà Nội,
    tìm nguyên nhân hư hỏng, ghi nhận nhu cầu và ngân sách, rồi mới lập dự toán từng hạng mục. Hợp đồng được ký sau khi
    bạn đã xem dự toán.
  </p>
  <p class="mx-auto mt-6 max-w-prose leading-relaxed text-muted">
    Mỗi công trình có một kỹ sư phụ trách, là đầu mối để bạn hỏi. Bạn thanh toán theo giai đoạn như ghi trong hợp đồng.
    Đội ngũ hơn 10 người gồm kỹ sư xây dựng, kiến trúc sư và quản lý thi công, có trên 10 năm kinh nghiệm làm nhà ở dân
    dụng tại Hà Nội.
  </p>
</ServiceSteps>

<section class="section" data-reveal>
  <div class="container-page">
    <SectionHeading
      title="Bảo hành sửa chữa bao lâu?"
      subtitle="Gia Khánh bảo hành bằng văn bản. Thời hạn ghi trong hợp đồng và tính riêng cho từng nhóm hạng mục: chống thấm, điện nước, hoàn thiện, sửa chữa nhỏ và bảo trì."
    />
    <div class="grid gap-8 lg:grid-cols-2">
      <InfoList rows={warrantyRows} />
      <div>
        <p class="leading-relaxed text-muted">
          Khi có sự cố trong thời hạn bảo hành, bạn liên hệ kỹ sư phụ trách hoặc hotline để Gia Khánh sắp xếp người đến xử
          lý.
        </p>
        <h3 class="mt-6 font-semibold">Cam kết khác</h3>
        <Bullets
          class="mt-4"
          items={[
            'Dùng đúng vật tư, chủng loại đã ghi trong hợp đồng.',
            'Vệ sinh công trình sạch sẽ trước khi bàn giao.',
          ]}
        />
      </div>
    </div>
  </div>
</section>

<section class="section bg-primary-light" data-reveal>
  <div class="container-page">
    <SectionHeading title="Gia Khánh nhận sửa nhà ở khu vực nào?" />
    <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
      <p>
        Gia Khánh nhận sửa chữa, cải tạo nhà tại nội thành Hà Nội và các huyện lân cận: {company.areaList.slice(1).join(', ')}.
        Trụ sở ở {company.address.replace(', TP Hà Nội', '')}, nên với nhà cần sửa ở Đông Anh, kỹ sư di chuyển đến khảo sát
        gần.
