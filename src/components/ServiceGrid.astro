---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data/services';
import { imagesIn } from '../data/images';

// cols=2 cho cột nội dung hẹp. Ảnh thẻ: thả 1 ảnh vào src/assets/dich-vu/<slug>/
const { cols = 4 } = Astro.props as { cols?: 2 | 4 };
---

<ul class:list={['grid gap-6 sm:grid-cols-2', cols === 4 && 'lg:grid-cols-4']}>
  {
    services.map((s, i) => {
      const img = imagesIn(s.slug)[0];
      return (
        <li data-reveal style={`--d:${(i % cols) * 90}ms`}>
          <a href={`/dich-vu/${s.slug}`} class="card group flex h-full flex-col overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-primary-light">
              {img ? (
                <Image
                  src={img}
                  alt=""
                  width={Math.min(img.width, 600)}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              ) : (
                <span class="flex h-full items-center justify-center text-sm text-muted">TODO: ảnh dịch vụ</span>
              )}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-lg leading-snug font-semibold group-hover:text-primary">{s.name}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{s.short}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-primary">
                Xem chi tiết <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>
