---
import { Image } from 'astro:assets';
import logo from '../assets/logo-ngang.png';
import { nav } from '../data/company';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header id="site-header" class="sticky top-0 z-40 bg-white transition-shadow">
  <div class="container-page relative flex h-12 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="Gia Khánh – Trang chủ">
      <Image src={logo} alt="Logo Gia Khánh" height={88} class="h-9 w-auto" loading="eager" />
    </a>

    <button
      id="menu-btn"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-md text-ink lg:hidden"
      aria-label="Mở menu"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <nav
      id="main-nav"
      aria-label="Điều hướng chính"
      class="flex items-center gap-1 lg:flex-1 max-lg:absolute max-lg:inset-x-0 max-lg:top-full max-lg:hidden max-lg:flex-col max-lg:items-stretch max-lg:border-t max-lg:border-line max-lg:bg-white max-lg:p-4 max-lg:shadow-md max-lg:data-[open]:flex"
    >
      <div class="max-lg:contents lg:flex lg:flex-1 lg:items-center lg:justify-between">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center rounded-md px-3 font-medium hover:text-primary',
              isActive(item.href) ? 'text-primary' : 'text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      </div>
      <a href="/lien-he" class="btn btn-primary max-lg:mt-2 lg:ml-6">Nhận báo giá</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('main-nav')!;
  const setOpen = (open: boolean) => {
    menu.toggleAttribute('data-open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(!menu.hasAttribute('data-open')));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.hasAttribute('data-open')) {
      setOpen(false);
      btn.focus();
    }
  });
  addEventListener('scroll', () => header.classList.toggle('shadow-sm', scrollY > 8), { passive: true });
</script>
