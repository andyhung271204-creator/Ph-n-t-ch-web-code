---
import Icon from './Icon.astro';
import { company, nav } from '../data/company';
import { services } from '../data/services';

const legal = [
  ['Mã số thuế', company.taxCode],
  ['Người đại diện', company.representative],
  ['Trụ sở', company.address],
];
const link = 'inline-flex min-h-11 items-center gap-2 text-white/80 transition-colors hover:text-white md:min-h-9';
---

<footer class="border-t border-white/10 bg-primary-dark text-white">
  <div class="container-page grid gap-10 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_0.8fr_1.3fr] lg:gap-8">
    <div class="text-sm leading-relaxed">
      <p class="flex items-center gap-3 text-lg font-bold">
        <span class="flex size-9 items-center justify-center rounded-md bg-white/10"><Icon name="home" class="size-5" /></span>
        {company.brand}
      </p>
      <p class="mt-3 font-semibold uppercase">{company.name}</p>
      <ul class="mt-4 space-y-2 text-white/80">
        {
          legal.map(([k, v]) => (
            <li>
              <span class="font-semibold text-white">{k}:</span> {v}
            </li>
          ))
        }
        <li>
          <span class="font-semibold text-white">Hotline / Zalo:</span>{' '}
          <a href={company.telUrl} class="font-semibold text-white underline">{company.phoneDisplay}</a>
        </li>
        <li>
          <span class="font-semibold text-white">Email:</span>{' '}
          <a href={`mailto:${company.email}`} class="break-all text-white underline">{company.email}</a>
        </li>
        <li><span class="font-semibold text-white">Giờ làm việc:</span> {company.hours}</li>
      </ul>
    </div>

    <div>
      <h2 class="text-lg font-semibold">Dịch vụ</h2>
      <ul class="mt-4 text-sm">
        {
          services.map((s) => (
            <li>
              <a href={`/dich-vu/${s.slug}/`} class={link}>
                <Icon name="chevron" class="size-3.5 -rotate-90 text-primary-bright" />
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-lg font-semibold">Liên kết nhanh</h2>
      <ul class="mt-4 text-sm">
        {
          nav.slice(1).map((n) => (
            <li>
              <a href={n.href} class={link}>
                <Icon name="chevron" class="size-3.5 -rotate-90 text-primary-bright" />
                {n.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={company.fanpageUrl} target="_blank" rel="noopener" class={link}>
            <Icon name="chevron" class="size-3.5 -rotate-90 text-primary-bright" />
            {company.fanpageLabel}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-lg font-semibold">Văn phòng Gia Khánh</h2>
      <div class="mt-4 overflow-hidden rounded-lg bg-black/20 ring-1 ring-white/10">
        <iframe
          src={company.mapUrl}
          title="Bản đồ trụ sở Gia Khánh tại Đông Anh, Hà Nội"
          class="h-44 w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <p class="flex gap-2 p-3 text-sm text-white/80">
          <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-primary-bright" />
          {company.address}
        </p>
      </div>
    </div>
  </div>
  <div class="border-t border-white/15 py-5 text-center text-sm text-white/70">
    © {new Date().getFullYear()} {company.name}
  </div>
</footer>
