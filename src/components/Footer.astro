---
import { company } from '../data/company';
---

<footer class="bg-primary-dark text-white">
  <div class="container-page grid items-center gap-10 py-16 md:grid-cols-2">
    <div class="text-sm leading-relaxed text-white/80">
      <p class="text-base font-semibold text-white">{company.name}</p>
      <ul class="mt-4 space-y-2">
        <li>Mã số thuế: {company.taxCode}</li>
        <li>Người đại diện: {company.representative}</li>
        <li>Trụ sở: {company.address}</li>
        <li>
          Hotline / Zalo:
          <a href={company.telUrl} class="font-semibold text-white underline">{company.phoneDisplay}</a>
        </li>
        <li>Email: {company.email}</li>
        <li>Giờ làm việc: {company.hours}</li>
      </ul>
    </div>
    <iframe
      src={company.mapUrl}
      title="Bản đồ trụ sở Gia Khánh tại Đông Anh, Hà Nội"
      class="h-64 w-full rounded-lg"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
  <div class="border-t border-white/15 py-4 text-center text-sm text-white/70">
    © {new Date().getFullYear()} {company.name}
  </div>
</footer>
