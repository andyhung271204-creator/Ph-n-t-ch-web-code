---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="mx-auto mb-12 max-w-2xl text-center">
  <h2 class="text-2xl font-bold uppercase md:text-3xl">{title}</h2>
  <span class="mx-auto mt-4 block h-1 w-16 rounded bg-primary-bright" aria-hidden="true"></span>
  {subtitle && <p class="mt-4 text-muted">{subtitle}</p>}
</div>
