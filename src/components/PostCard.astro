---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Post } from '../data/posts';

interface Props {
  post: Post;
  index?: number;
  /** Thẻ lớn (bài nổi bật ở trang chủ): ảnh to, có đoạn tóm tắt */
  large?: boolean;
  class?: string;
}
const { post, index = 0, large = false, class: cls } = Astro.props;
---

<a href={`/cam-nang/${post.slug}/`} class:list={['card group flex flex-col overflow-hidden', cls]} data-reveal style={`--d:${index * 90}ms`}>
  <div class:list={['overflow-hidden bg-primary-light', large ? 'aspect-[3/2]' : 'aspect-[4/3]']}>
    <Image
      src={post.cover}
      alt={`Công trình Gia Khánh thi công – minh họa bài: ${post.title}`}
      width={large ? 1000 : 600}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col p-5 md:p-6">
    <h3 class:list={['font-semibold group-hover:text-primary', large ? 'text-xl leading-snug md:text-2xl' : 'text-base leading-snug']}>
      {post.title}
    </h3>
    {large && <p class="mt-3 line-clamp-3 leading-relaxed text-muted">{post.excerpt}</p>}
    <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-primary">
      Đọc bài viết <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
