---
import { Image } from 'astro:assets';
import type { Post } from '../data/posts';

interface Props {
  post: Post;
  index?: number;
  /** Thẻ lớn (bài nổi bật ở trang chủ): ảnh to, có đoạn tóm tắt */
  large?: boolean;
  class?: string;
}
const { post, index = 0, large = false, class: cls } = Astro.props;
---

<a href={`/cam-nang/${post.slug}`} class:list={['group block', cls]} data-reveal style={`--d:${index * 90}ms`}>
  <div class:list={['overflow-hidden bg-white', large ? 'aspect-[3/2]' : 'aspect-[4/3]']}>
    <Image
      src={post.cover}
      alt={`Công trình Gia Khánh thi công – minh họa bài: ${post.title}`}
      width={large ? 1000 : 600}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <h3 class:list={['mt-4 font-semibold group-hover:text-primary', large ? 'text-xl md:text-2xl' : 'text-base']}>
    {post.title}
  </h3>
  {large && <p class="mt-3 italic leading-relaxed text-muted">{post.excerpt}</p>}
</a>
