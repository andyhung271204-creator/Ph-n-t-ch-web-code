---
import { Image } from 'astro:assets';
import { imagesIn } from '../data/images';

interface Props {
  project: { slug: string; name: string; category?: string };
  index?: number;
}
const { project, index = 0 } = Astro.props;
const cover = imagesIn(project.slug)[0];
---

<a
  href={`/du-an/${project.slug}/`}
  class="card group block overflow-hidden"
  data-reveal
  style={`--d:${(index % 3) * 90}ms`}
>
  <div class="aspect-[4/3] overflow-hidden bg-primary-light">
    {
      cover ? (
        <Image
          src={cover}
          alt={`${project.name.replace(/^Công trình /, 'Công trình số ')} do Gia Khánh thi công`}
          width={Math.min(cover.width, 800)}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-sm text-muted">TODO: ảnh công trình</div>
      )
    }
  </div>
  <div class="p-4">
    <h3 class="font-semibold">{project.name}</h3>
    {project.category && <p class="mt-1 text-sm text-muted">{project.category}</p>}
  </div>
</a>
