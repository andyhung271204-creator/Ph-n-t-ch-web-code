---
import Icon from './Icon.astro';

interface Props {
  /** Chuỗi, hoặc [phần in đậm, phần còn lại] */
  items: (string | [string, string])[];
  class?: string;
}
const { items, class: cls } = Astro.props;
---

<ul class:list={['space-y-4', cls]}>
  {
    items.map((it) => (
      <li class="flex gap-3 leading-relaxed">
        <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-primary" />
        <span>{typeof it === 'string' ? it : <><strong>{it[0]}</strong> {it[1]}</>}</span>
      </li>
    ))
  }
</ul>
