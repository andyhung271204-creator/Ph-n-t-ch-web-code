---
import SectionHeading from './SectionHeading.astro';

interface Props {
  title?: string;
  steps: { name: string; text: string }[];
  /** Nền xanh nhạt (mặc định) hoặc trắng, để giữ nhịp xen kẽ section */
  light?: boolean;
}
const { title = 'Quy trình 6 bước', steps, light = true } = Astro.props;
---

<section class:list={['section', light ? 'bg-primary-light' : 'bg-white']} data-reveal>
  <div class="container-page">
    <SectionHeading title={title} />
    <ol class="relative grid gap-8 md:grid-cols-2 lg:grid-cols-6 lg:gap-4">
      <!-- Đường nối các bước (desktop) -->
      <span class="absolute top-6 right-[8%] left-[8%] hidden h-0.5 bg-primary-bright/50 lg:block" aria-hidden="true"></span>
      {
        steps.map((s, i) => (
          <li class="relative flex gap-4 lg:block lg:text-center" data-reveal style={`--d:${i * 80}ms`}>
            <span class={`relative flex size-12 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-white ring-8 lg:mx-auto ${light ? "ring-primary-light" : "ring-white"}`}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="lg:mt-5">
              <h3 class="font-semibold">{s.name}</h3>
              <p class="mt-1 leading-relaxed text-muted lg:mt-2 lg:text-sm">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <slot />
  </div>
</section>
