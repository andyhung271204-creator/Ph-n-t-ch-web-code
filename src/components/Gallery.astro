---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
}
const { images, alt } = Astro.props;
---

{
  images.length ? (
    <ul class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
      {images.map((img, i) => (
        <li class="aspect-[4/3] overflow-hidden rounded-lg bg-primary-light" data-reveal style={`--d:${(i % 3) * 90}ms`}>
          <Image src={img} alt={`${alt} – ảnh ${i + 1}`} width={Math.min(img.width, 800)} class="h-full w-full object-cover" />
        </li>
      ))}
    </ul>
  ) : (
    <div class="flex aspect-[4/3] max-w-md items-center justify-center rounded-lg bg-primary-light text-sm text-muted">
      TODO: ảnh công trình
    </div>
  )
}
