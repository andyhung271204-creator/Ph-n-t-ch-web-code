---
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';
import { company } from '../data/company';

interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---

<!-- Dải CTA xanh đậm: lời mời bên trái, form bên phải -->
<section id="bao-gia" class="relative isolate scroll-mt-20 overflow-hidden bg-primary-dark py-16 text-white md:py-24" data-reveal>
  <div class="stripes absolute -top-20 -left-20 -z-10 h-80 w-80 rotate-12 opacity-40" aria-hidden="true"></div>
  <div class="container-page grid items-center gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
    <div>
      <p class="inline-block rounded bg-white/10 px-3 py-1 text-sm font-semibold tracking-wide uppercase">Khảo sát & báo giá miễn phí</p>
      <h2 class="mt-5 text-3xl leading-tight font-bold md:text-4xl">{title}</h2>
      <p class="mt-5 max-w-prose text-lg leading-relaxed text-white/85">{subtitle}</p>
      <a href={company.telUrl} class="mt-8 inline-flex min-h-11 items-center gap-4 rounded-lg bg-white/10 px-5 py-4 ring-1 ring-white/15 transition-colors hover:bg-white/15">
        <Icon name="phone" class="size-6" />
        <span>
          <span class="block text-sm text-white/75">Hotline / Zalo</span>
          <span class="block text-xl font-bold">{company.phoneDisplay}</span>
        </span>
      </a>
    </div>
    <div data-reveal style="--d:90ms">
      <QuoteForm title="Nhận báo giá miễn phí"><slot /></QuoteForm>
    </div>
  </div>
</section>
