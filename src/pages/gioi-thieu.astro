---
// Nội dung: noi-dung/gioi-thieu.md
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Bullets from '../components/Bullets.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import logo from '../assets/logo-gia-khanh.png';
import { company } from '../data/company';

const huyen = company.areaList.slice(1).join(', ');
const link = 'font-semibold text-primary underline hover:text-primary-dark';
const h2 = 'text-center text-2xl font-bold uppercase md:text-3xl';
const th = 'bg-primary-light p-4 text-left font-semibold';
const td = 'border-t border-line p-4 align-top';

const menu = [
  { href: '#ve-chung-toi', label: 'Về Gia Khánh' },
  { href: '#tam-nhin', label: 'Tầm nhìn, giá trị' },
  { href: '#dich-vu', label: 'Dịch vụ' },
  { href: '#doi-ngu', label: 'Đội ngũ' },
  { href: '#phap-ly', label: 'Thông tin công ty' },
  { href: '#cong-trinh-bao-gia', label: 'Công trình, báo giá' },
  { href: '/lien-he/', label: 'Liên hệ' },
];

const values = [
  ['Minh bạch', 'Báo giá chi tiết từng hạng mục, vật tư ghi rõ chủng loại. Không phát sinh khi chủ nhà chưa đồng ý.'],
  ['Tận tâm', 'Làm nhà cho khách như làm nhà cho gia đình mình. Kỹ sư phụ trách giám sát trực tiếp tại công trình.'],
  ['Đúng hẹn', 'Tiến độ có mốc rõ ràng trong hợp đồng. Hình ảnh công trình gửi hằng ngày qua Zalo.'],
  ['Chất lượng', 'Thi công đúng kỹ thuật, nghiệm thu từng giai đoạn cùng chủ nhà.'],
  ['Trách nhiệm', 'Bảo hành bằng văn bản, có mặt xử lý khi khách cần.'],
];

const services = [
  {
    href: '/dich-vu/xay-nha-tron-goi/',
    name: 'Xây nhà trọn gói',
    text: 'nhà phố, nhà ống, nhà cấp 4 và biệt thự nhỏ, từ móng đến hoàn thiện, có dự toán chi tiết trước khi ký hợp đồng.',
  },
  {
    href: '/dich-vu/sua-chua-cai-tao-nha/',
    name: 'Sửa chữa, cải tạo nhà',
    text: 'cải tạo nhà cũ, nâng tầng, chống thấm, xử lý nứt, điện nước và bảo trì. Khảo sát miễn phí.',
  },
  {
    href: '/dich-vu/thiet-ke-kien-truc-noi-that/',
    name: 'Thiết kế kiến trúc và nội thất',
    text: 'mặt bằng công năng, phối cảnh 3D ngoại thất và nội thất, hồ sơ kỹ thuật thi công.',
  },
  {
    href: '/dich-vu/hoan-thien-thi-cong-noi-that/',
    name: 'Hoàn thiện và thi công nội thất',
    text: 'ốp lát, sơn bả, trần thạch cao, cửa nhôm kính, tủ bếp, tủ quần áo và đồ gỗ theo thiết kế.',
  },
];

const legal = [
  ['Tên đầy đủ', company.name],
  ['Thương hiệu', company.brand],
  ['Tên tiếng Anh', company.nameEn],
  ['Mã số thuế', company.taxCode],
  ['Loại hình', 'Công ty trách nhiệm hữu hạn'],
  ['Ngành nghề chính', 'Xây dựng nhà để ở'],
  ['Trụ sở', company.address],
  ['Người đại diện', company.representative],
  ['Hotline, Zalo', company.phoneDisplay],
];

const faqs = [
  {
    q: 'Gia Khánh có trụ sở ở đâu?',
    a: `Trụ sở ở ${company.address}. Gia Khánh nhận công trình ở nội thành Hà Nội và các huyện lân cận như ${huyen}.`,
  },
  {
    q: 'Mã số thuế của Gia Khánh là gì, tra cứu thế nào?',
    a: `Mã số thuế của ${company.name} là ${company.taxCode}. Bạn nhập mã này vào cổng tra cứu thông tin doanh nghiệp rồi đối chiếu tên, địa chỉ và người đại diện với trang này.`,
  },
  {
    q: 'Đội ngũ Gia Khánh có kinh nghiệm bao lâu?',
    a: 'Đội ngũ có trên 10 năm kinh nghiệm thi công nhà ở dân dụng tại Hà Nội. Đó là kinh nghiệm của các kỹ sư, kiến trúc sư và quản lý thi công, còn công ty mới thành lập.',
  },
  {
    q: 'Tôi có xem được công trình Gia Khánh đã làm không?',
    a: `Có. Trang Công trình có ảnh các công trình Gia Khánh đã thi công. Muốn hỏi thêm về một hạng mục cụ thể, bạn gọi ${company.phoneDisplay} để trao đổi với kỹ sư.`,
  },
];
---

<BaseLayout
  title={`${company.name}, Đông Anh`}
  description={`${company.name}, MST ${company.taxCode}, trụ sở xã Đông Anh, Hà Nội. Đội ngũ hơn 10 người, nhận xây, sửa nhà. Gọi khảo sát miễn phí.`}
>
  <PageHeader
    title="Giới thiệu Công ty TNHH Xây dựng và Đầu tư Gia Khánh"
    crumb="Giới thiệu"
    subtitle={`${company.name}, mã số thuế ${company.taxCode}, là đơn vị xây dựng và sửa chữa nhà ở có trụ sở tại xã Đông Anh, TP Hà Nội. Gia Khánh nhận xây nhà trọn gói, sửa chữa cải tạo, thiết kế và hoàn thiện nội thất cho gia đình ở Hà Nội.`}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/bao-gia/#nhan-bao-gia" class="btn btn-primary">Nhận báo giá miễn phí</a>
      <a href={company.telUrl} class="btn btn-outline bg-white">Gọi ngay {company.phoneDisplay}</a>
      <a href={company.zaloUrl} class="btn btn-outline bg-white" target="_blank" rel="noopener">Chat Zalo</a>
    </div>
  </PageHeader>

  <section class="bg-primary-light py-10 md:py-16" data-reveal>
    <div class="container-page grid gap-8 lg:grid-cols-[16rem_1fr] lg:items-start">
      <!-- Thanh bên -->
      <aside class="overflow-hidden rounded-lg bg-white shadow-sm lg:sticky lg:top-24" data-reveal>
        <div class="hidden bg-primary p-5 lg:block">
          <div class="rounded-md bg-white p-3">
            <Image src={logo} alt="Logo Gia Khánh" width={200} class="mx-auto h-28 w-auto" />
          </div>
        </div>
        <nav aria-label="Mục lục trang giới thiệu">
          <ul class="flex flex-wrap gap-2 p-3 lg:block lg:p-0">
            {
              menu.map((m) => (
                <li class="lg:border-b lg:border-line lg:last:border-0">
                  <a
                    href={m.href}
                    class="flex min-h-11 items-center justify-center rounded-md border border-line px-3 text-sm transition-colors hover:border-primary hover:text-primary lg:rounded-none lg:border-0 lg:border-l-4 lg:border-transparent lg:text-base lg:hover:border-primary lg:hover:bg-primary-light"
                  >
                    {m.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <!-- Nội dung -->
      <div class="min-w-0 rounded-lg bg-white px-4 py-10 shadow-sm md:px-10">
        <section id="ve-chung-toi" class="scroll-mt-24" data-reveal>
          <h2 class={h2}>Gia Khánh là công ty gì?</h2>
          <span class="divider" aria-hidden="true"></span>
          <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
            <p>
              Gia Khánh là thương hiệu của {company.name}, công ty xây dựng nhà ở đặt trụ sở tại Đông Anh, Hà Nội. Công ty
              mới thành lập, còn đội ngũ thi công có trên 10 năm kinh nghiệm làm nhà ở dân dụng tại Hà Nội.
            </p>
            <p class="text-muted">
              Với đa số gia đình, xây hay sửa một ngôi nhà là khoản đầu tư lớn. Vì vậy Gia Khánh báo giá chi tiết từng hạng
              mục, ký hợp đồng rõ ràng và cập nhật tiến độ cho chủ nhà thường xuyên. Mỗi công trình có một kỹ sư phụ trách
              giám sát tại chỗ và gửi ảnh tiến độ hằng ngày qua Zalo.
            </p>
            <p class="text-muted">Gia Khánh nhận công trình ở nội thành Hà Nội và các huyện lân cận như {huyen}.</p>
          </div>
        </section>

        <section id="tam-nhin" class="mt-16 scroll-mt-24 md:mt-20" data-reveal>
          <h2 class={h2}>Tầm nhìn, sứ mệnh và giá trị cốt lõi của Gia Khánh là gì?</h2>
          <span class="divider" aria-hidden="true"></span>
          <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
            <p>
              Gia Khánh đặt mục tiêu đến năm 2031 trở thành đơn vị xây dựng và sửa chữa nhà ở được các gia đình Hà Nội tin
              chọn và giới thiệu cho người thân. Sứ mệnh là giúp mỗi gia đình xây, sửa nhà an tâm: đúng dự toán, đúng tiến
              độ, đúng chất lượng đã cam kết.
            </p>
            <p class="text-muted">Năm giá trị cốt lõi dưới đây là cách công ty làm việc với chủ nhà.</p>
          </div>
          <div class="mx-auto mt-8 max-w-3xl overflow-x-auto rounded-lg border border-line bg-white" data-reveal>
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class={th} scope="col">Giá trị</th>
                  <th class={th} scope="col">Chủ nhà nhận được</th>
                </tr>
              </thead>
              <tbody>
                {
                  values.map(([k, v]) => (
                    <tr>
                      <th class={`${td} text-left font-semibold whitespace-nowrap text-primary`} scope="row">{k}</th>
                      <td class={`${td} leading-relaxed text-muted`}>{v}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section id="dich-vu" class="mt-16 scroll-mt-24 md:mt-20" data-reveal>
          <h2 class={h2}>Gia Khánh làm những dịch vụ nào?</h2>
          <span class="divider" aria-hidden="true"></span>
          <div class="mx-auto max-w-prose space-y-6 leading-relaxed">
            <p>
              Gia Khánh làm bốn nhóm dịch vụ cho nhà ở tại Hà Nội: xây nhà trọn gói, sửa chữa cải tạo nhà, thiết kế kiến trúc
              và nội thất, hoàn thiện và thi công nội thất. Mỗi nhóm có một trang riêng ghi phạm vi công việc, quy trình và
              cách tính chi phí.
            </p>
            <ul class="space-y-4">
              {
                services.map((s, i) => (
                  <li class="flex gap-3" data-reveal style={`--d:${i * 90}ms`}>
                    <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-primary" />
                    <span>
                      <a href={s.href} class={link}>{s.name}</a>: {s.text}
                    </span>
                  </li>
                ))
              }
            </ul>
            <p>Xem tổng quan tại trang <a href="/dich-vu/" class={link}>Dịch vụ</a>.</p>
          </div>
        </section>

        <section id="doi-ngu" class="mt-16 scroll-mt-24 md:mt-20" data-reveal>
          <h2 class={h2}>Đội ngũ Gia Khánh gồm những ai?</h2>
          <span class="divider" aria-hidden="true"></span>
          <div class="mx-auto max-w-prose space-y-6 leading-relaxed">
            <p>
              Đội ngũ Gia Khánh có hơn 10 người, gồm kỹ sư xây dựng, kiến trúc sư và quản lý thi công, do ông Đỗ Như Duy đứng
              đầu. Đội ngũ có trên 10 năm kinh nghiệm thi công nhà ở dân dụng tại Hà Nội. Số năm này tính cho đội ngũ, còn
              công ty mới thành lập.
            </p>
            <Bullets
              items={[
                ['Người đứng đầu:', `${company.representative}.`],
                [
                  'Kỹ sư xây dựng:',
                  'mỗi công trình có một kỹ sư phụ trách. Kỹ sư đo đạc khi khảo sát, giám sát tại công trình và nghiệm thu từng giai đoạn cùng chủ nhà.',
                ],
                ['Kiến trúc sư:', 'lập phương án thiết kế khi gia đình cần, từ mặt bằng công năng đến phối cảnh 3D.'],
                ['Quản lý thi công:', 'theo dõi tiến độ theo các mốc ghi trong hợp đồng.'],
              ]}
            />
            <p class="text-muted">Đội ngũ quen với nhà ống, nhà trong ngõ và quy định cấp phép tại địa phương.</p>
          </div>
        </section>

        <section id="phap-ly" class="mt-16 scroll-mt-24 md:mt-20" data-reveal>
          <h2 class={h2}>Thông tin công ty Gia Khánh để bạn đối chiếu</h2>
          <span class="divider" aria-hidden="true"></span>
          <p class="mx-auto max-w-prose leading-relaxed">
            {company.name} có mã số thuế {company.taxCode}, trụ sở tại {company.address}, do ông Đỗ Như Duy đại diện. Nhiều
            doanh nghiệp mang tên Gia Khánh, nên hãy đối chiếu cả mã số thuế và địa chỉ khi tra cứu.
          </p>
          <div class="mx-auto mt-8 max-w-3xl overflow-x-auto rounded-lg border border-line bg-white" data-reveal>
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class={th} scope="col">Mục</th>
                  <th class={th} scope="col">Thông tin</th>
                </tr>
              </thead>
              <tbody>
                {
                  legal.map(([k, v]) => (
                    <tr>
                      <th class={`${td} text-left font-normal whitespace-nowrap text-muted`} scope="row">{k}</th>
                      <td class={`${td} font-medium`}>{v}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section id="cong-trinh-bao-gia" class="mt-16 scroll-mt-24 md:mt-20" data-reveal>
          <h2 class={h2}>Xem công trình và báo giá ở đâu?</h2>
          <span class="divider" aria-hidden="true"></span>
          <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
            <p>
              Ảnh các công trình Gia Khánh đã thi công có ở trang <a href="/du-an/" class={link}>Công trình</a>, đơn giá xây
              nhà theo m² có ở trang <a href="/bao-gia/" class={link}>Báo giá</a>. Muốn kỹ sư khảo sát miễn phí tại khu đất
              hoặc ngôi nhà của bạn ở Hà Nội, hãy gọi <a href={company.telUrl} class={link}>{company.phoneDisplay}</a> hoặc gửi
              số điện thoại qua trang <a href="/lien-he/" class={link}>Liên hệ</a>.
            </p>
            <p class="text-muted">
              Với nhà đã có và cần sửa, kỹ sư đến xem hiện trạng trước rồi mới lập báo giá từng hạng mục. Với đất trống, bạn
              có dự toán chi tiết trước khi ký hợp đồng.
            </p>
          </div>
        </section>
      </div>
    </div>
  </section>

  <Faq title="Câu hỏi thường gặp về Gia Khánh" items={faqs} />
</BaseLayout>

<style>
  /* Gạch trang trí kiểu mẫu: đường – chấm – đường */
  .divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 1rem auto 2.5rem;
    background: radial-gradient(circle, var(--color-primary-bright) 3px, transparent 3.5px) center / 8px 8px no-repeat;
  }
  .divider::before,
  .divider::after {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: var(--color-muted);
    opacity: 0.5;
  }
</style>
