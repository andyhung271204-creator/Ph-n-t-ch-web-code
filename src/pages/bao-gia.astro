---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { company, houseModels, packages } from '../data/company';
import { imagesIn } from '../data/images';

const tien = (v: number) =>
  v >= 1e9
    ? `${(v / 1e9).toLocaleString('vi-VN', { maximumFractionDigits: 2 })} tỷ`
    : `${Math.round(v / 1e7) * 10} triệu`;

// Mobile: mỗi dòng thành thẻ 3 cột, nhãn lấy từ data-label; từ md trở lên là bảng thường.
const th = 'bg-primary-light p-4 text-left text-sm font-semibold tracking-wide text-primary uppercase';
const td =
  'whitespace-nowrap md:border-t md:border-line md:p-4 md:align-middle before:block before:text-sm before:font-normal before:text-muted before:content-[attr(data-label)] md:before:hidden';
---

<BaseLayout
  title="Báo giá xây nhà theo mẫu tại Hà Nội"
  description="Bảng giá ước tính xây 48 mẫu nhà phố, nhà ống, biệt thự của Gia Khánh: gói phần thô và gói trọn gói. Để lại thông tin để nhận báo giá chi tiết miễn phí."
>
  <PageHeader
    title="Báo giá xây nhà"
    subtitle="Giá ước tính theo từng mẫu nhà. Để lại thông tin, kỹ sư Gia Khánh sẽ khảo sát và gửi báo giá chính xác miễn phí."
  />

  <!-- Đơn giá theo m² từng gói — thiết kế: design/stitch/bao-gia-don-gia-m2.html -->
  <section class="section" data-reveal>
    <div class="container-page">
      <SectionHeading title="Đơn giá theo m² từng gói" />
      <ul class="mx-auto grid max-w-xl items-stretch gap-6 lg:max-w-none lg:grid-cols-3 lg:gap-8">
        {
          packages.map((p, i) => {
            const hot = i === 1;
            return (
              <li
                class:list={[
                  'relative flex flex-col rounded-lg p-6 md:p-8',
                  hot ? 'border-2 border-primary bg-primary-light shadow-md lg:-my-2' : 'card',
                ]}
                data-reveal
                style={`--d:${i * 90}ms`}
              >
                {hot && (
                  <span class="absolute -top-3 right-6 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white">Đề xuất</span>
                )}
                <h3 class:list={['text-lg font-semibold', hot && 'text-primary-dark']}>{p.name}</h3>
                <p class="mt-4 flex flex-wrap items-baseline gap-x-2">
                  {p.perM2.startsWith('từ ') && <span class="font-semibold text-muted">từ</span>}
                  <span class="text-3xl font-bold whitespace-nowrap text-primary md:text-4xl">{p.perM2.replace('từ ', '')}</span>
                  <span class="font-semibold text-muted">đ/m²</span>
                </p>
                <p class="mt-6 text-sm font-semibold tracking-wide text-primary uppercase">Bao gồm</p>
                <ul class="mt-3 space-y-2">
                  {p.includes.replace(/\.$/, '').split('; ').map((t) => (
                    <li class="flex gap-2 text-sm leading-relaxed">
                      <Icon name="check" class="mt-0.5 size-4 shrink-0 text-primary" />
                      <span>{t[0].toUpperCase() + t.slice(1)}.</span>
                    </li>
                  ))}
                </ul>
                <div class:list={['mt-5 border-t pt-5', hot ? 'border-primary/20' : 'border-line']}>
                  <p class="text-sm font-semibold tracking-wide text-muted uppercase">Chủ nhà tự lo</p>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{p.owner}</p>
                </div>
                <div class="mt-auto pt-6">
                  <a href="#nhan-bao-gia" class:list={['btn w-full', hot ? 'btn-primary' : 'btn-outline bg-white']}>
                    Nhận báo giá
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
      <p class="mt-10 flex gap-3 rounded-lg border border-primary/20 bg-primary-light p-4 font-medium">
        <Icon name="file" class="mt-0.5 size-5 shrink-0 text-primary" />
        <span>{company.priceNote}</span>
      </p>
    </div>
  </section>

  <section class="section bg-primary-light" data-reveal>
    <div class="container-page">
      <SectionHeading
        title="Bảng giá theo mẫu nhà"
        subtitle="Giá ước tính theo diện tích sàn quy đổi phổ biến của từng mẫu. Ảnh là mẫu phối cảnh tham khảo."
      />
      <div class="overflow-x-auto rounded-lg border border-line bg-white shadow-sm">
        <table class="block w-full border-collapse md:table">
          <thead class="hidden md:table-header-group">
            <tr>
              <th class={th} scope="col">Mẫu nhà</th>
              <th class={th} scope="col">Diện tích sàn ước tính</th>
              <th class={th} scope="col">Phần thô + nhân công hoàn thiện</th>
              <th class={th} scope="col">Trọn gói</th>
            </tr>
          </thead>
          <tbody class="block md:table-row-group">
            {
              houseModels.map((m) => (
                <tr class="grid grid-cols-3 gap-x-3 gap-y-3 border-t border-line p-4 transition-colors first:border-t-0 hover:bg-primary-light/40 md:table-row md:p-0">
                  <th class="col-span-3 text-left font-medium md:border-t md:border-line md:p-4 md:align-middle" scope="row">
                    <span class="flex items-center gap-4">
                      <Image
                        src={imagesIn(`mau-nha/${m.id}`)[0]}
                        alt={`Phối cảnh mẫu ${m.id}: ${m.name.toLowerCase()}`}
                        width={192}
                        class="aspect-[4/3] w-24 shrink-0 rounded-md object-cover"
                      />
                      <span>
                        <span class="block text-sm font-semibold text-muted uppercase">Mẫu {m.id}</span>
                        {m.name}
                      </span>
                    </span>
                  </th>
                  <td class={td} data-label="Diện tích">~{m.area} m²</td>
                  <td class={td} data-label="Phần thô">≈ {tien(m.rough)}</td>
                  <td class={`${td} font-semibold text-primary`} data-label="Trọn gói">≈ {tien(m.full)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-6 flex gap-3 rounded-lg border border-primary/20 bg-primary-light p-4 font-medium">
        <Icon name="file" class="mt-0.5 size-5 shrink-0 text-primary" />
        <span>Giá trên chỉ để tham khảo, tính theo diện tích ước tính của mẫu. {company.priceNote}</span>
      </p>
    </div>
  </section>

  <section id="nhan-bao-gia" class="section scroll-mt-20" data-reveal>
    <div class="container-page">
      <SectionHeading
        title="Nhận báo giá chi tiết"
        subtitle="Để lại thông tin và mẫu nhà bạn quan tâm, Gia Khánh sẽ gọi lại tư vấn miễn phí."
      />
      <div class="mx-auto max-w-2xl">
        <QuoteForm>
          <label class="block text-sm font-medium">
            Mẫu nhà quan tâm
            <select class="field mt-1" name="mau-nha">
              <option value="">Chưa chọn / thiết kế riêng</option>
              {houseModels.map((m) => <option value={`Mẫu ${m.id} – ${m.name}`}>Mẫu {m.id} – {m.name}</option>)}
            </select>
          </label>
        </QuoteForm>
      </div>
    </div>
  </section>
</BaseLayout>
