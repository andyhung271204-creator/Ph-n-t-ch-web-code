---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/company';

const rows = [
  { icon: 'pin', label: 'Trụ sở', value: company.address },
  { icon: 'mail', label: 'Email', value: company.email, href: `mailto:${company.email}` },
  { icon: 'globe', label: 'Fanpage', value: company.fanpageLabel, href: company.fanpageUrl, external: true },
  { icon: 'clock', label: 'Giờ làm việc', value: company.hours },
  { icon: 'map', label: 'Khu vực phục vụ', value: company.area },
] as const;
---

<BaseLayout
  title="Liên hệ – Nhận báo giá miễn phí"
  description={`Liên hệ Gia Khánh để được khảo sát và báo giá miễn phí: hotline / Zalo ${company.phoneDisplay}, trụ sở tại Đông Anh, Hà Nội.`}
>
  <PageHeader title="Liên hệ với Gia Khánh" crumb="Liên hệ" subtitle={company.cta} />

  <section class="section" data-reveal>
    <div class="container-page mb-12">
      <p class="text-sm font-semibold tracking-wide text-primary uppercase">Khảo sát & báo giá miễn phí</p>
      <h2 class="mt-3 text-3xl leading-tight font-bold md:text-4xl">Bạn đang có kế hoạch xây hoặc sửa nhà?</h2>
      <p class="mt-4 max-w-prose text-lg leading-relaxed text-muted">Để lại số điện thoại, Gia Khánh sẽ gọi lại tư vấn miễn phí.</p>
    </div>
    <div class="container-page grid items-start gap-8 lg:grid-cols-[1fr_1.3fr] lg:gap-10">
      <div class="card p-6 md:p-8" data-reveal>
        <h2 class="border-b border-line pb-4 text-xl font-bold">{company.name}</h2>
        <a href={company.telUrl} class="mt-6 flex items-center gap-4">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary text-white"><Icon name="phone" /></span>
          <span>
            <span class="block text-sm text-muted">Hotline / Zalo</span>
            <span class="block text-2xl font-bold text-primary">{company.phoneDisplay}</span>
          </span>
        </a>
        <dl class="mt-6 space-y-5">
          {
            rows.map((r) => (
              <div class="flex gap-4">
                <span class="icon-tile"><Icon name={r.icon} /></span>
                <div class="min-w-0">
                  <dt class="text-sm text-muted">{r.label}</dt>
                  <dd class="mt-0.5 leading-relaxed font-medium">
                    {'href' in r ? (
                      <a href={r.href} class="break-all text-primary underline hover:text-primary-dark" {...('external' in r ? { target: '_blank', rel: 'noopener' } : {})}>
                        {r.value}
                      </a>
                    ) : (
                      r.value
                    )}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
        <div class="mt-8 grid grid-cols-2 gap-3 border-t border-line pt-6">
          <a href={company.telUrl} class="btn btn-primary"><Icon name="phone" class="size-4" /> Gọi ngay</a>
          <a href={company.zaloUrl} target="_blank" rel="noopener" class="btn btn-outline">Chat Zalo</a>
        </div>
      </div>
      <div data-reveal style="--d:90ms">
        <QuoteForm title="Nhận báo giá miễn phí" />
      </div>
    </div>
  </section>
</BaseLayout>
