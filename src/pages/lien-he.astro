---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import Bullets from '../components/Bullets.astro';
import Faq from '../components/Faq.astro';
import { company } from '../data/company';

const link = 'font-semibold text-primary underline hover:text-primary-dark';
const huyen = company.areaList.slice(1).join(', '); // bỏ "Hà Nội" ở đầu danh sách

const rows = [
  { icon: 'file', label: 'Mã số thuế', value: company.taxCode },
  { icon: 'pin', label: 'Trụ sở', value: company.address },
  { icon: 'mail', label: 'Email', value: company.email, href: `mailto:${company.email}` },
  { icon: 'globe', label: 'Fanpage', value: company.fanpageLabel, href: company.fanpageUrl, external: true },
  { icon: 'clock', label: 'Giờ làm việc', value: company.hours }, // xn(): "Đang cập nhật" cho tới khi daXacNhan = true
] as const;

const faqs = [
  {
    q: 'Khảo sát có miễn phí không, tôi cần chuẩn bị gì?',
    a: 'Có. Kỹ sư Gia Khánh khảo sát miễn phí và gửi báo giá chi tiết. Bạn chỉ cần cho biết địa chỉ, nhu cầu và ảnh hiện trạng nếu nhà đã có. Chưa có bản vẽ hay ngân sách cũng không sao.',
  },
  {
    q: 'Gia Khánh nhận công trình ở khu vực nào?',
    a: 'Hà Nội, gồm nội thành và các huyện lân cận như Đông Anh, Gia Lâm, Hoài Đức. Gửi địa chỉ cụ thể để Gia Khánh xác nhận lịch khảo sát.',
  },
  {
    q: 'Để lại số điện thoại thì bao lâu được gọi lại?',
    a: `Gia Khánh sẽ gọi lại để tư vấn sơ bộ và hẹn lịch khảo sát. Cần nhanh hơn, bạn gọi thẳng hotline hoặc nhắn Zalo ${company.phoneDisplay}.`,
  },
  {
    q: 'Tôi chưa có bản vẽ, hoặc chưa biết nên xây mới hay sửa, có liên hệ được không?',
    a: 'Được. Chưa có bản vẽ thì bắt đầu từ dịch vụ Thiết kế kiến trúc và nội thất. Chưa chắc sửa hay xây lại, kỹ sư sẽ đánh giá khi khảo sát. Xem tổng quan tại trang Dịch vụ.',
  },
];
---

{/* meta_title đã có "Gia Khánh" nên BaseLayout không thêm hậu tố; truyền nguyên văn để <title> khớp bản nháp. */}
<BaseLayout
  title="Liên hệ Gia Khánh xây dựng, khảo sát miễn phí | Gia Khánh"
  description={`Liên hệ Gia Khánh xây dựng: gọi hoặc nhắn Zalo ${company.phoneDisplay}, trụ sở tại Đông Anh, Hà Nội. Kỹ sư khảo sát miễn phí, báo giá xây nhà và sửa nhà.`}
>
  <PageHeader
    title="Liên hệ Gia Khánh xây dựng để khảo sát và báo giá miễn phí"
    crumb="Liên hệ"
    subtitle={`Gọi hoặc nhắn Zalo ${company.phoneDisplay}, hoặc để lại số điện thoại trong form bên dưới. ${company.name} sẽ gọi lại, hẹn kỹ sư đến khảo sát khu đất hoặc ngôi nhà của bạn ở Hà Nội. Khảo sát và báo giá đều miễn phí.`}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#nhan-bao-gia" class="btn btn-primary">Nhận báo giá miễn phí</a>
      <a href={company.telUrl} class="btn btn-outline bg-white">Gọi ngay {company.phoneDisplay}</a>
      <a href={company.zaloUrl} class="btn btn-outline bg-white" target="_blank" rel="noopener">Chat Zalo</a>
    </div>
  </PageHeader>

  <section class="section" data-reveal>
    <div class="container-page">
      <SectionHeading title="Bạn đang có kế hoạch xây hoặc sửa nhà?" />
      <p class="mx-auto mb-10 max-w-prose leading-relaxed">
        Điền họ tên, số điện thoại, khu vực và nhu cầu vào form, Gia Khánh sẽ gọi lại tư vấn miễn phí. Bạn chưa cần có bản vẽ
        hay ngân sách chốt sẵn. Nói loại nhà, số tầng, diện tích đất hoặc vấn đề ngôi nhà đang gặp là đủ để kỹ sư chuẩn bị cho
        buổi khảo sát.
      </p>
      <div class="grid items-start gap-8 lg:grid-cols-[1fr_1.3fr] lg:gap-10">
        <div id="nhan-bao-gia" class="scroll-mt-20 lg:order-2" data-reveal>
          <QuoteForm title="Nhận báo giá miễn phí" />
        </div>
        <div class="card p-6 md:p-8" data-reveal style="--d:90ms">
          <p class="font-semibold">Có sẵn những thông tin sau thì buổi khảo sát đi nhanh hơn:</p>
          <Bullets
            class="mt-5"
            items={[
              'Địa chỉ khu đất hoặc ngôi nhà.',
              'Bạn muốn xây mới, sửa chữa, thiết kế hay hoàn thiện nội thất.',
              'Ảnh hiện trạng, nếu nhà đã có.',
              'Ngân sách dự kiến, nếu bạn đã nghĩ tới.',
            ]}
          />
          <p class="mt-6 border-t border-line pt-6 leading-relaxed">
            Muốn xem đơn giá trước khi gọi, đọc <a href="/bao-gia/" class={link}>bảng báo giá xây nhà</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-primary-light" data-reveal>
    <div class="container-page">
      <SectionHeading title="Thông tin liên hệ của Gia Khánh" />
      <p class="mx-auto mb-10 max-w-prose leading-relaxed">
        {company.name} (mã số thuế {company.taxCode}) đặt trụ sở tại {company.address}. Hotline và Zalo dùng chung một số,
        {company.phoneDisplay}. Bạn cũng có thể nhắn qua fanpage hoặc gửi email.
      </p>
      <div class="grid items-stretch gap-8 lg:grid-cols-2 lg:gap-10">
        <div class="card p-6 md:p-8" data-reveal>
          <h3 class="border-b border-line pb-4 text-xl font-bold">{company.name}</h3>
          <a href={company.telUrl} class="mt-6 flex items-center gap-4">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary text-white"><Icon name="phone" /></span>
            <span>
              <span class="block text-sm text-muted">Hotline / Zalo</span>
              <span class="block text-2xl font-bold text-primary">{company.phoneDisplay}</span>
            </span>
          </a>
          <dl class="mt-6 space-y-5">
            {
              rows.map((r) => (
                <div class="flex gap-4">
                  <span class="icon-tile"><Icon name={r.icon} /></span>
                  <div class="min-w-0">
                    <dt class="text-sm text-muted">{r.label}</dt>
                    <dd class="mt-0.5 leading-relaxed font-medium">
                      {'href' in r ? (
                        <a href={r.href} class="break-all text-primary underline hover:text-primary-dark" {...('external' in r ? { target: '_blank', rel: 'noopener' } : {})}>
                          {r.value}
                        </a>
                      ) : (
                        r.value
                      )}
                    </dd>
                  </div>
                </div>
              ))
            }
          </dl>
          <div class="mt-8 grid grid-cols-2 gap-3 border-t border-line pt-6">
            <a href={company.telUrl} class="btn btn-primary"><Icon name="phone" class="size-4" /> Gọi ngay</a>
            <a href={company.zaloUrl} target="_blank" rel="noopener" class="btn btn-outline">Chat Zalo</a>
          </div>
        </div>
        <div class="overflow-hidden rounded-lg border border-line bg-white shadow-sm" data-reveal style="--d:90ms">
          <iframe
            src={company.mapUrl}
            title="Bản đồ trụ sở Gia Khánh tại Đông Anh, Hà Nội"
            class="block h-80 w-full lg:h-full lg:min-h-96"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
      <p class="mt-10 text-center leading-relaxed">
        Ảnh các công trình Gia Khánh đã thi công xem tại trang <a href="/du-an/" class={link}>Công trình</a>.
      </p>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container-page">
      <SectionHeading title="Gia Khánh nhận công trình ở khu vực nào?" />
      <p class="mx-auto max-w-prose leading-relaxed">
        Gia Khánh nhận xây nhà, sửa nhà và hoàn thiện nội thất tại Hà Nội, gồm nội thành và các huyện lân cận: {huyen}. Trụ sở
        ở Đông Anh, kỹ sư khảo sát khu vực này thuận tiện. Gửi địa chỉ qua <a href="#nhan-bao-gia" class={link}>form</a> hoặc
        <a href={company.zaloUrl} class={link} target="_blank" rel="noopener">Zalo</a> để xác nhận lịch khảo sát.
      </p>
    </div>
  </section>

  <Faq title="Câu hỏi thường gặp khi liên hệ" class="bg-primary-light" items={faqs} />
</BaseLayout>
