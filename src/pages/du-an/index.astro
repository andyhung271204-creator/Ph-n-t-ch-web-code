---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Công trình đã thi công"
  description="Hình ảnh thực tế các công trình nhà ở, nội thất, quán cà phê, đổ bê tông do Gia Khánh thi công tại Hà Nội."
>
  <PageHeader title="Công trình" subtitle="Hình ảnh thực tế từ các công trình Gia Khánh thi công." />
  <section class="section" data-reveal>
    <div class="container-page grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>
</BaseLayout>
