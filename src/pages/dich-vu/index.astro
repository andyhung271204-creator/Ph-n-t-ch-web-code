---
// Nội dung: noi-dung/dich-vu.md
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import { company } from '../../data/company';
import { services } from '../../data/services';
import { imagesIn } from '../../data/images';

const link = 'font-semibold text-primary underline hover:text-primary-dark';
const th = 'bg-primary-light p-4 text-left font-semibold';
const td = 'border-t border-line p-4 align-top';

// Mô tả thẻ và chữ link theo bản nháp, theo slug trong `services`
const cards: Record<string, { text: string; cta: string }> = {
  'xay-nha-tron-goi': {
    text: 'Thi công từ móng đến hoàn thiện cho nhà phố, nhà ống, nhà cấp 4 và biệt thự nhỏ. Bạn có dự toán chi tiết trước khi ký hợp đồng.',
    cta: 'Xem dịch vụ xây nhà trọn gói',
  },
  'sua-chua-cai-tao-nha': {
    text: 'Cải tạo, nâng tầng, sửa chữa nhà cũ; chống thấm, xử lý nứt tường; lắp đặt, sửa điện nước và bảo trì nhà.',
    cta: 'Xem dịch vụ sửa chữa cải tạo nhà',
  },
  'thiet-ke-kien-truc-noi-that': {
    text: 'Mặt bằng công năng, phối cảnh 3D ngoại thất và nội thất, hồ sơ kỹ thuật thi công.',
    cta: 'Xem dịch vụ thiết kế kiến trúc và nội thất',
  },
  'hoan-thien-thi-cong-noi-that': {
    text: 'Ốp lát, sơn bả, trần thạch cao, cửa, tủ bếp, tủ quần áo và đồ gỗ theo thiết kế.',
    cta: 'Xem dịch vụ hoàn thiện và thi công nội thất',
  },
};

const svc = Object.fromEntries(services.map((s) => [s.slug, { href: `/dich-vu/${s.slug}/`, name: s.name }]));
const situations = [
  ['Có đất, muốn xây nhà ở mới', svc['xay-nha-tron-goi']],
  ['Nhà thấm, nứt tường hoặc xuống cấp', svc['sua-chua-cai-tao-nha']],
  ['Cần bản vẽ và phối cảnh trước khi xây', svc['thiet-ke-kien-truc-noi-that']],
  ['Đã xong phần thô, hoặc muốn làm mới nội thất', svc['hoan-thien-thi-cong-noi-that']],
] as const;

const faqs = [
  {
    q: 'Nhà tôi nên xây mới hay sửa, bắt đầu từ dịch vụ nào?',
    a: 'Chưa chắc nên sửa hay xây lại thì bắt đầu bằng buổi khảo sát miễn phí: kỹ sư Gia Khánh đến xem hiện trạng rồi tư vấn. Muốn tự tìm hiểu trước, bạn đọc bài Kiểm tra nhà cũ trước khi cải tạo trong mục Cẩm nang.',
  },
  {
    q: 'Gia Khánh có làm cả thiết kế lẫn thi công không?',
    a: 'Có. Gia Khánh nhận cả thiết kế kiến trúc và nội thất lẫn thi công xây dựng, hoàn thiện. Chưa có bản vẽ thì bạn bắt đầu từ thiết kế.',
  },
  {
    q: 'Khảo sát và báo giá có miễn phí không?',
    a: `Có. Kỹ sư Gia Khánh đến tận nơi khảo sát và gửi báo giá chi tiết từng hạng mục, không thu phí. ${company.priceNote}`,
  },
  {
    q: 'Tôi xem giá ở đâu?',
    a: 'Đơn giá xây nhà theo mét vuông xem tại trang Báo giá. Các dịch vụ còn lại được báo giá riêng, theo hạng mục, sau khi kỹ sư khảo sát.',
  },
];
---

<BaseLayout
  title="Dịch vụ xây dựng nhà ở Hà Nội: xây nhà, sửa nhà"
  description="Dịch vụ xây dựng nhà ở Hà Nội của Gia Khánh: xây nhà trọn gói, sửa chữa cải tạo, thiết kế, hoàn thiện nội thất. Khảo sát miễn phí. Nhận báo giá miễn phí."
>
  <PageHeader
    title="Dịch vụ xây dựng và sửa chữa nhà ở tại Hà Nội"
    crumb="Dịch vụ"
    subtitle={`${company.name} nhận bốn nhóm dịch vụ cho nhà ở Hà Nội: xây nhà trọn gói, sửa chữa cải tạo, thiết kế kiến trúc và nội thất, hoàn thiện và thi công nội thất. Mỗi nhóm có trang riêng với phạm vi và quy trình. Khảo sát, báo giá miễn phí.`}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/bao-gia/#nhan-bao-gia" class="btn btn-primary">Nhận báo giá miễn phí</a>
      <a href={company.telUrl} class="btn btn-outline bg-white">Gọi ngay {company.phoneDisplay}</a>
      <a href={company.zaloUrl} class="btn btn-outline bg-white" target="_blank" rel="noopener">Chat Zalo</a>
    </div>
  </PageHeader>

  <section class="section" data-reveal>
    <div class="container-page">
      <SectionHeading title="Gia Khánh nhận những dịch vụ nào?" />
      <p class="mx-auto mb-10 max-w-prose leading-relaxed">
        Gia Khánh nhận bốn nhóm dịch vụ cho nhà ở: xây nhà mới từ móng đến hoàn thiện, sửa chữa và cải tạo nhà cũ, thiết
        kế trước khi xây, và hoàn thiện nội thất sau phần thô. Bạn chọn đúng nhóm mình cần, hoặc đi từ thiết kế sang thi
        công cùng một đơn vị.
      </p>
      <ul class="grid gap-6 sm:grid-cols-2 lg:gap-8">
        {
          services.map((s, i) => {
            const img = imagesIn(s.slug)[0];
            return (
              <li class="card flex flex-col overflow-hidden" data-reveal style={`--d:${(i % 2) * 90}ms`}>
                {img && (
                  <Image src={img} alt="" width={Math.min(img.width, 800)} class="aspect-[16/9] w-full object-cover" />
                )}
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-xl font-semibold">{s.name}</h3>
                  <p class="mt-2 leading-relaxed text-muted">{cards[s.slug].text}</p>
                  <a
                    href={`/dich-vu/${s.slug}/`}
                    class="mt-auto inline-flex min-h-11 items-center gap-1.5 pt-4 font-semibold text-primary hover:text-primary-dark"
                  >
                    {cards[s.slug].cta} <Icon name="arrow" class="size-4" />
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section bg-primary-light" data-reveal>
    <div class="container-page">
      <SectionHeading title="Bạn đang ở tình huống nào, chọn dịch vụ nào?" />
      <p class="mx-auto max-w-prose leading-relaxed">
        Bạn có đất và muốn xây nhà mới thì chọn xây nhà trọn gói. Nhà đang thấm, nứt hoặc xuống cấp thì chọn sửa chữa –
        cải tạo. Chưa có bản vẽ thì bắt đầu từ thiết kế. Đã xong phần thô, hoặc muốn làm mới nội thất, thì chọn hoàn thiện
        và thi công nội thất.
      </p>
      <div class="mx-auto mt-10 max-w-3xl overflow-x-auto rounded-lg border border-line bg-white">
        <table class="w-full min-w-[520px] border-collapse">
          <thead>
            <tr>
              <th class={th} scope="col">Tình huống của bạn</th>
              <th class={th} scope="col">Dịch vụ phù hợp</th>
            </tr>
          </thead>
          <tbody>
            {
              situations.map(([t, s]) => (
                <tr>
                  <th class={`${td} text-left font-medium`} scope="row">{t}</th>
                  <td class={td}>
                    <a href={s.href} class={link}>{s.name}</a>
                  </td>
                </tr>
              ))
            }
            <tr>
              <th class={`${td} text-left font-medium`} scope="row">Chưa chắc nên sửa hay xây lại</th>
              <td class={td}>
                Đọc bài{' '}
                <a href="/cam-nang/kiem-tra-truoc-khi-cai-tao-nha-cu/" class={link}>
                  Kiểm tra nhà cũ trước khi cải tạo: cần xem những gì?
                </a>{' '}
                rồi để kỹ sư khảo sát miễn phí
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container-page">
      <SectionHeading title="Gói thi công và giá" />
      <p class="mx-auto max-w-prose leading-relaxed">
        Xây nhà tại Gia Khánh có ba gói: phần thô + nhân công hoàn thiện, trọn gói chìa khóa trao tay, và nhân công xây
        dựng. Đơn giá theo mét vuông xem ở trang <a href="/bao-gia/" class={link}>Báo giá</a>. {company.priceNote}
      </p>
    </div>
  </section>

  <section class="section bg-primary-light" data-reveal>
    <div class="container-page">
      <SectionHeading title="Làm việc với Gia Khánh thế nào?" />
      <div class="mx-auto max-w-prose space-y-4 leading-relaxed">
        <p>
          Gia Khánh làm việc theo sáu bước: tiếp nhận tư vấn, khảo sát miễn phí, thiết kế và báo giá, ký hợp đồng, thi
          công và giám sát, bàn giao và bảo hành. Bảo hành bằng văn bản, thời hạn ghi trong hợp đồng. Chi tiết xem ở
          <a href="/dich-vu/xay-nha-tron-goi/" class={link}>Xây nhà trọn gói</a> hoặc
          <a href="/dich-vu/sua-chua-cai-tao-nha/" class={link}>Sửa chữa – cải tạo nhà</a>.
        </p>
        <p>Ảnh các công trình Gia Khánh đã thi công xem tại trang <a href="/du-an/" class={link}>Công trình</a>.</p>
      </div>
    </div>
  </section>

  <Faq title="Câu hỏi thường gặp về dịch vụ" items={faqs} />
</BaseLayout>
