---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import XayNhaTronGoi from '../../components/dich-vu/XayNhaTronGoi.astro';
import SuaChuaCaiTao from '../../components/dich-vu/SuaChuaCaiTao.astro';
import ThietKe from '../../components/dich-vu/ThietKe.astro';
import HoanThien from '../../components/dich-vu/HoanThien.astro';
import { services } from '../../data/services';
import { company } from '../../data/company';

export const getStaticPaths = () => services.map((service) => ({ params: { slug: service.slug }, props: { service } }));

const { service } = Astro.props;
const bodies: Record<string, any> = {
  'xay-nha-tron-goi': XayNhaTronGoi,
  'sua-chua-cai-tao-nha': SuaChuaCaiTao,
  'thiet-ke-kien-truc-noi-that': ThietKe,
  'hoan-thien-thi-cong-noi-that': HoanThien,
};
const Body = bodies[service.slug];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  serviceType: service.name,
  description: service.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  provider: { '@id': new URL('/#org', Astro.site).href },
  areaServed: company.areaList.map((name) => ({ '@type': 'Place', name })),
};
---

<BaseLayout title={service.metaTitle} description={service.metaDescription}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <PageHeader
    title={service.heading}
    crumb={service.name}
    subtitle={service.lead}
    parent={{ href: '/dich-vu/', label: 'Dịch vụ' }}
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="#bao-gia" class="btn btn-primary">Nhận báo giá miễn phí</a>
      <a href={company.telUrl} class="btn btn-outline bg-white">Gọi ngay {company.phoneDisplay}</a>
      <a href={company.zaloUrl} target="_blank" rel="noopener" class="btn btn-outline bg-white">Chat Zalo</a>
    </div>
  </PageHeader>

  <Body />
</BaseLayout>
